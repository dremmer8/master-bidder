  genreRu: "\u041F\u043E\u0440\u0442\u0440\u0435\u0442"
  factRu: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u0435
    \u0432 1825 \u0433\u043E\u0434\u0443 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B
    \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u0435\u0440 \u0432\u0430\u043D
    \u0434\u0435\u0440 \u0425\u043E\u043E\u043F, \u0440\u0435\u0448\u0438\u0432,
    \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u043C\u0438 \u043E\u0442\u0435\u0446,
    \u0434\u0430\u0440\u044F\u0449\u0438\u0439 \u0434\u043E\u0447\u0435\u0440\u0438
    \u0441\u0432\u0430\u0434\u0435\u0431\u043D\u043E\u0435 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435;
    \u043A\u0435\u043C \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0430 \u043F\u0430\u0440\u0430,
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u0432\u0435\u0434\u044B
    \u0441\u043F\u043E\u0440\u044F\u0442 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440.
    \u0412\u0430\u043D \u0413\u043E\u0433 \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u043B\u0441\u044F,
    \u0447\u0442\u043E \u043E\u0442\u0434\u0430\u043B \u0431\u044B \u0434\u0435\u0441\u044F\u0442\u044C
    \u043B\u0435\u0442 \u0436\u0438\u0437\u043D\u0438 \u0437\u0430 \u0434\u0432\u0435
    \u043D\u0435\u0434\u0435\u043B\u0438 \u043F\u0435\u0440\u0435\u0434 \u044D\u0442\u0438\u043C
    \u043F\u043E\u043B\u043E\u0442\u043D\u043E\u043C \u0441 \u043A\u0443\u0441\u043A\u043E\u043C
    \u0441\u0443\u0445\u043E\u0433\u043E \u0445\u043B\u0435\u0431\u0430."
