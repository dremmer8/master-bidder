    \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0438, \u043E\u0442\u043A\u0440\u044B\u0432\u0448\u0435\u0439\u0441\u044F
    \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0434\u0435\u043D\u044C
    \u043F\u043E\u0441\u043B\u0435 \u0435\u0451 \u043F\u043E\u0445\u043E\u0440\u043E\u043D:
