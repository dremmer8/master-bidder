    \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u0437\u0430 \u0434\u043E\u043B\u0433\u0438,
    \u2014 \u043E\u0442\u0441\u044E\u0434\u0430 \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E
    \u0433\u0440\u0443\u0431\u0430\u044F \u0438 \u0440\u0430\u0437\u043C\u0430\u0448\u0438\u0441\u0442\u0430\u044F
    \u043C\u0430\u043D\u0435\u0440\u0430 \u043F\u0438\u0441\u044C\u043C\u0430. \u041F\u043E\u043B\u043E\u0442\u043D\u043E
    \u0441\u043E\u0437\u0434\u0430\u043D\u043E \u0434\u043B\u044F \u0445\u0430\u0440\u043B\u0435\u043C\u0441\u043A\u043E\u0439
    \u0431\u043E\u0433\u0430\u0434\u0435\u043B\u044C\u043D\u0438, \u0437\u0434\u0430\u043D\u0438\u0435
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
