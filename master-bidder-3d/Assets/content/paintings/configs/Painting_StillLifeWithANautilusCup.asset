  genreRu: "\u041D\u0430\u0442\u044E\u0440\u043C\u043E\u0440\u0442"
  factRu: "\u0420\u0430\u043A\u043E\u0432\u0438\u043D\u0443 \u0441\u043E\u0437\u0434\u0430\u043B\u0430
    \u043F\u0440\u0438\u0440\u043E\u0434\u0430, \u0440\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u0438\u043A
    \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B \u0435\u0451 \u0432 \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0439
    \u043A\u0443\u0431\u043E\u043A, \u0430 \u041A\u0430\u043B\u044C\u0444 \u2014
    \u0432 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438:
    \u044D\u0442\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u043D\u0430\u044F
    \u0438 \u0434\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0441\u043B\u0443\u0436\u0438\u0442 \u043E\u043F\u043E\u0440\u043D\u043E\u0439
    \u0442\u043E\u0447\u043A\u043E\u0439 \u0434\u043B\u044F \u0434\u0430\u0442\u0438\u0440\u043E\u0432\u043A\u0438
    \u0432\u0441\u0435\u0433\u043E \u0435\u0433\u043E \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430.
    \u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u043A\u043E\u0432\u0451\u0440
    \u0438 \u043B\u0438\u043C\u043E\u043D, \u043E\u0447\u0438\u0449\u0435\u043D\u043D\u044B\u0439
    \u043F\u043E \u0441\u043F\u0438\u0440\u0430\u043B\u0438, \u2014 \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u044B\u0435
    \u043F\u0440\u0438\u0451\u043C\u044B \xAB\u043F\u0440\u0443\u043D\u043A\xBB-\u043D\u0430\u0442\u044E\u0440\u043C\u043E\u0440\u0442\u043E\u0432
    \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430."
