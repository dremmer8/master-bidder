  genreRu: "\u041F\u0435\u0439\u0437\u0430\u0436"
  factRu: "\u0422\u0430 \u0441\u0430\u043C\u0430\u044F \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
    \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442,
