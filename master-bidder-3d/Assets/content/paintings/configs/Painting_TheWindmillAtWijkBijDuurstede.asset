    \u043D\u0430 \u0444\u043E\u043D\u0435 \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043D\u0435\u0431\u0430, \u0441\u0442\u0430\u043B\u043E \u043F\u043E\u0447\u0442\u0438
    \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C \u0433\u043E\u043B\u043B\u0430\u043D\u0434\u0441\u043A\u043E\u0433\u043E
    \u043F\u0435\u0439\u0437\u0430\u0436\u0430. \u0421 1885 \u0433\u043E\u0434\u0430
    \u043A\u0430\u0440\u0442\u0438\u043D\u0430 \u0432\u0438\u0441\u0438\u0442 \u0432
    \u0413\u0430\u043B\u0435\u0440\u0435\u0435 \u043F\u043E\u0447\u0451\u0442\u0430
    \u0430\u043C\u0441\u0442\u0435\u0440\u0434\u0430\u043C\u0441\u043A\u043E\u0433\u043E
    \u0420\u0435\u0439\u043A\u0441\u043C\u0443\u0437\u0435\u0443\u043C."
