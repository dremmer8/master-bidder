  titleRu: "\u0423\u0440\u043E\u043A \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0438
    \u0434\u043E\u043A\u0442\u043E\u0440\u0430 \u0422\u0443\u043B\u044C\u043F\u0430"
  artistRu: "\u0420\u0435\u043C\u0431\u0440\u0430\u043D\u0434\u0442 \u0432\u0430\u043D
    \u0420\u0435\u0439\u043D"
  year: 1632
  periodRu: "\u0413\u043E\u043B\u043B\u0430\u043D\u0434\u0441\u043A\u043E\u0435 \u0437\u043E\u043B\u043E\u0442\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F"
  genreRu: "\u0413\u0440\u0443\u043F\u043F\u043E\u0432\u043E\u0439 \u043F\u043E\u0440\u0442\u0440\u0435\u0442"
  factRu: "\u0422\u0440\u0443\u043F \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u2014
    \u043A\u0430\u0437\u043D\u0451\u043D\u043D\u044B\u0439 \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A
    \u0410\u0440\u0438\u0441 \u041A\u0438\u043D\u0442, \u043F\u043E\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u0439
    \u0432 \u0442\u043E\u0442 \u0436\u0435 \u0434\u0435\u043D\u044C \u0437\u0430
    \u0443\u043B\u0438\u0447\u043D\u044B\u0439 \u0433\u0440\u0430\u0431\u0451\u0436;
    \u0445\u0438\u0440\u0443\u0440\u0433\u0438 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
    \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u0443
    \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0433\u043E \u0437\u0430\u043B\u0430
    \u0432 \u0430\u043C\u0441\u0442\u0435\u0440\u0434\u0430\u043C\u0441\u043A\u043E\u0439
    \u0412\u0430\u0433\u0435. \u0420\u0435\u043D\u0442\u0433\u0435\u043D \u0445\u043E\u043B\u0441\u0442\u0430
    \u043F\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043A\u0438\u0441\u0442\u044C
    \u0440\u0443\u043A\u0438 \u0442\u0440\u0443\u043F\u0430 \u0431\u044B\u043B\u0430
    \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u0430\u043D\u0430 \u2014 \u0441\u043F\u0435\u0440\u0432\u0430
    \u0420\u0435\u043C\u0431\u0440\u0430\u043D\u0434\u0442 \u0447\u0435\u0441\u0442\u043D\u043E
    \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B \u043E\u0431\u0440\u0443\u0431\u043E\u043A,
    \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u043F\u043E\u0441\u043B\u0435
    \u0430\u043C\u043F\u0443\u0442\u0430\u0446\u0438\u0438."
