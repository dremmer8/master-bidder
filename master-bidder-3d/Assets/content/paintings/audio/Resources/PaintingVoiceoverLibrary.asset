      \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: a4ad21e73509bfe48850a9e5210e286d, type: 3}
  - key: 1434
    sourceText: "\u0442\u044B\u0441\u044F\u0447\u0430 \u0447\u0435\u0442\u044B\u0440\u0435\u0441\u0442\u0430
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: d0e429c73e5e40b469d5e80f3b754632, type: 3}
  - key: 1484-1486
    sourceText: "\u0413\u043E\u0434 \u2014 \u0441 \u0442\u044B\u0441\u044F\u0447\u0438
      \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u0441\u043E\u0442 \u0432\u043E\u0441\u044C\u043C\u0438\u0434\u0435\u0441\u044F\u0442\u0438
      \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u0433\u043E \u043F\u043E \u0442\u044B\u0441\u044F\u0447\u0430
      \u0447\u0435\u0442\u044B\u0440\u0435\u0441\u0442\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0434\u0435\u0441\u044F\u0442
      \u0448\u0435\u0441\u0442\u043E\u0439 \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: 3a42c3122987b074b9e46df6ba86d574, type: 3}
  - key: 1495-1498
    sourceText: "\u0413\u043E\u0434 \u2014 \u0441 \u0442\u044B\u0441\u044F\u0447\u0438
      \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u0441\u043E\u0442 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u0430
      \u043F\u044F\u0442\u043E\u0433\u043E \u043F\u043E \u0442\u044B\u0441\u044F\u0447\u0430
      \u0447\u0435\u0442\u044B\u0440\u0435\u0441\u0442\u0430 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E
      \u0432\u043E\u0441\u044C\u043C\u043E\u0439 \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: 4d007eb21819ba74ebae144b163b27ff, type: 3}
  - key: 1503-1519
    sourceText: "\u0413\u043E\u0434 \u2014 \u0441 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043F\u044F\u0442\u0438\u0441\u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
      \u043F\u043E \u0442\u044B\u0441\u044F\u0447\u0430 \u043F\u044F\u0442\u044C\u0441\u043E\u0442
      \u0434\u0435\u0432\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439
      \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: 6367d49e666a14943a99262ad6c23836, type: 3}
  - key: 1508-1512
    sourceText: "\u0413\u043E\u0434 \u2014 \u0441 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043F\u044F\u0442\u0438\u0441\u043E\u0442 \u0432\u043E\u0441\u044C\u043C\u043E\u0433\u043E
      \u043F\u043E \u0442\u044B\u0441\u044F\u0447\u0430 \u043F\u044F\u0442\u044C\u0441\u043E\u0442
      \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439 \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: ee24b3b194178404b9b740e72f23bbe8, type: 3}
  - key: 1509-1511
    sourceText: "\u0413\u043E\u0434 \u2014 \u0441 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043F\u044F\u0442\u0438\u0441\u043E\u0442 \u0434\u0435\u0432\u044F\u0442\u043E\u0433\u043E
      \u043F\u043E \u0442\u044B\u0441\u044F\u0447\u0430 \u043F\u044F\u0442\u044C\u0441\u043E\u0442
      \u043E\u0434\u0438\u043D\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439 \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: 034a729af554c1e43ab2abe8e344b4e8, type: 3}
  - key: 1512-1513
    sourceText: "\u0413\u043E\u0434 \u2014 \u0441 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043F\u044F\u0442\u0438\u0441\u043E\u0442 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0433\u043E
      \u043F\u043E \u0442\u044B\u0441\u044F\u0447\u0430 \u043F\u044F\u0442\u044C\u0441\u043E\u0442
      \u0442\u0440\u0438\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439 \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: e3a4e5fc610513b458d2f473275e9091, type: 3}
  - key: 1520-1523
    sourceText: "\u0413\u043E\u0434 \u2014 \u0441 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043F\u044F\u0442\u0438\u0441\u043E\u0442 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u043E\u0433\u043E
      \u043F\u043E \u0442\u044B\u0441\u044F\u0447\u0430 \u043F\u044F\u0442\u044C\u0441\u043E\u0442
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0435\u0442\u0438\u0439
      \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: bbff2b2016e5b434bb97dc000f160df8, type: 3}
  - key: 1523
    sourceText: "\u0442\u044B\u0441\u044F\u0447\u0430 \u043F\u044F\u0442\u044C\u0441\u043E\u0442
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0435\u0442\u0438\u0439
      \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: b0247ab2d8e906040a5a06e37c3fb1e6, type: 3}
  - key: 1599-1600
    sourceText: "\u0413\u043E\u0434 \u2014 \u0441 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043F\u044F\u0442\u0438\u0441\u043E\u0442 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u0430
      \u0434\u0435\u0432\u044F\u0442\u043E\u0433\u043E \u043F\u043E \u0442\u044B\u0441\u044F\u0447\u0430
      \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442 \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: 42c8eb8e4e7160e49b11f852308786cf, type: 3}
  - key: 1601
    sourceText: "\u0442\u044B\u0441\u044F\u0447\u0430 \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: 4e2cc0c47c7772c41b9fbb957628cc91, type: 3}
  - key: 1614-1620
    sourceText: "\u0413\u043E\u0434 \u2014 \u0441 \u0442\u044B\u0441\u044F\u0447\u0438
      \u0448\u0435\u0441\u0442\u0438\u0441\u043E\u0442 \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0433\u043E
      \u043F\u043E \u0442\u044B\u0441\u044F\u0447\u0430 \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044B\u0439 \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: 9775d7c5f755b544eb8e8cb19171b8a3, type: 3}
  - key: 1624
    sourceText: "\u0442\u044B\u0441\u044F\u0447\u0430 \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
