    clip: {fileID: 8300000, guid: 81c2e2746d2b51d41ae3c1208f6b87e4, type: 3}
  - key: 1628
    sourceText: "\u0442\u044B\u0441\u044F\u0447\u0430 \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0432\u043E\u0441\u044C\u043C\u043E\u0439
      \u0433\u043E\u0434."
    clip: {fileID: 8300000, guid: decbc10a65812874a95124a8b7250485, type: 3}
  - key: 1631
    sourceText: "\u0442\u044B\u0441\u044F\u0447\u0430 \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043F\u0435\u0440\u0432\u044B\u0439
