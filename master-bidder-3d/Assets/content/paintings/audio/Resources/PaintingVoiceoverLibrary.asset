  - key: tribute-money
    sourceText: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u2014 \u0427\u0443\u0434\u043E
      \u0441\u043E \u0441\u0442\u0430\u0442\u0438\u0440\u043E\u043C."
    clip: {fileID: 8300000, guid: d859359c4c9d28448816e252acbe8d70, type: 3}
  - key: venus-and-mars
    sourceText: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u2014 \u0412\u0435\u043D\u0435\u0440\u0430
      \u0438 \u041C\u0430\u0440\u0441."
    clip: {fileID: 8300000, guid: 6f30fd3b5b5dcb3459bbc9f64a6d9c53, type: 3}
  - key: wanderer-above-the-sea-of-fog
    sourceText: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u2014 \u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A
      \u043D\u0430\u0434 \u043C\u043E\u0440\u0435\u043C \u0442\u0443\u043C\u0430\u043D\u0430."
    clip: {fileID: 8300000, guid: 7ac0e54a35f524244bcce43725e4a0cb, type: 3}
  - key: water-lilies
    sourceText: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u2014 \u041A\u0443\u0432\u0448\u0438\u043D\u043A\u0438."
    clip: {fileID: 8300000, guid: 4c1bcfb73a052124a9d9d46788b39184, type: 3}
  facts:
  - key: a-bar-at-the-folies-bergere
    sourceText: "\u041E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0432 \u0437\u0435\u0440\u043A\u0430\u043B\u0435
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0431\u0430\u0440\u043C\u0435\u043D\u0448\u0438
      \u0421\u044E\u0437\u043E\u043D \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442
      \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u043E
      \u0431\u044B\u0442\u044C \u0432\u0438\u0434\u043D\u043E \u043F\u043E \u0437\u0430\u043A\u043E\u043D\u0430\u043C
      \u043E\u043F\u0442\u0438\u043A\u0438, \u2014 \u044D\u0442\u0443 \u0437\u0430\u0433\u0430\u0434\u043A\u0443
      \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u044B \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u0432\u0435\u0434\u044B
      \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u044E\u0442 \u0443\u0436\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0435\u043A\u0430."
    clip: {fileID: 8300000, guid: 863ac6f79d338bf439306045fc4e32fc, type: 3}
  - key: a-burial-at-ornans
    sourceText: "\u041F\u043E\u043B\u043E\u0442\u043D\u043E \u0434\u043B\u0438\u043D\u043E\u0439
      \u0431\u043E\u043B\u0435\u0435 \u0448\u0435\u0441\u0442\u0438 \u043C\u0435\u0442\u0440\u043E\u0432
      \u2014 \u043C\u0430\u0441\u0448\u0442\u0430\u0431, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0442\u043E\u0433\u0434\u0430 \u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0441\u044F
      \u043B\u0438\u0448\u044C \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0438\u043B\u0438 \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u044B\u043C
      \u0441\u044E\u0436\u0435\u0442\u0430\u043C, \u2014 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442
      \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u044B
      \u0432 \u0440\u043E\u0434\u043D\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u043A\u0435
      \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430 \u0438 \u0432\u044B\u0437\u0432\u0430\u043B\u043E
      \u0441\u043A\u0430\u043D\u0434\u0430\u043B \u043D\u0430 \u0421\u0430\u043B\u043E\u043D\u0435
      \u0441 \u0442\u044B\u0441\u044F\u0447\u0438 \u0432\u043E\u0441\u044C\u043C\u0438\u0441\u043E\u0442
      \u043F\u044F\u0442\u0438\u0434\u0435\u0441\u044F\u0442\u043E\u0433\u043E \u043F\u043E
      \u0442\u044B\u0441\u044F\u0447\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u043E\u0432."
    clip: {fileID: 8300000, guid: 1c9ea76e7bd21be47add14a1c67f8436, type: 3}
  - key: apollo-and-marsyas-ribera
    sourceText: "\u0420\u0438\u0431\u0435\u0440\u0430, \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C
      \u0440\u0430\u0431\u043E\u0442\u0430\u0432\u0448\u0438\u0439 \u0432 \u041D\u0435\u0430\u043F\u043E\u043B\u0435
      \u043F\u043E\u0434 \u0438\u0441\u043F\u0430\u043D\u0441\u043A\u0438\u043C \u0432\u043B\u0430\u0434\u044B\u0447\u0435\u0441\u0442\u0432\u043E\u043C,
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0442\u0430\u043C \u043F\u0440\u043E\u0437\u0432\u0438\u0449\u0435
      \xAB\u041B\u043E \u0421\u043F\u0430\u043D\u044C\u043E\u043B\u0435\u0442\u0442\u043E\xBB
      (\xAB\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0438\u0441\u043F\u0430\u043D\u0435\u0446\xBB)
      \u2014 \u044D\u0442\u0430 \u0441\u0446\u0435\u043D\u0430 \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u0441\u0430\u0442\u0438\u0440\u0430 \u041C\u0430\u0440\u0441\u0438\u044F \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445
      \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u044B\u0445
      \u0432\u043E\u043F\u043B\u043E\u0449\u0435\u043D\u0438\u0439 \u043C\u0438\u0444\u0430
      \u0432 \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438."
    clip: {fileID: 8300000, guid: 6c065a0dff79d2e4faafaa8edd9f321f, type: 3}
  - key: arnolfini-portrait
    sourceText: "\u0412 \u0432\u044B\u043F\u0443\u043A\u043B\u043E\u043C \u0437\u0435\u0440\u043A\u0430\u043B\u0435
      \u043D\u0430 \u0437\u0430\u0434\u043D\u0435\u043C \u043F\u043B\u0430\u043D\u0435
      \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F \u0444\u0438\u0433\u0443\u0440\u044B
      \u0434\u0432\u0443\u0445 \u043B\u044E\u0434\u0435\u0439, \u0430 \u0440\u044F\u0434\u043E\u043C
      \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043F\u043E\u0434\u043F\u0438\u0441\u044C \xAB\u042F\u043D \u0432\u0430\u043D
      \u042D\u0439\u043A \u0431\u044B\u043B \u0437\u0434\u0435\u0441\u044C\xBB."
    clip: {fileID: 8300000, guid: 0011ef840471f304b8f686e4a2d492d6, type: 3}
  - key: at-the-moulin-rouge
    sourceText: "\u0421\u0430\u043C \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A
      \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B \u0441\u0435\u0431\u044F
      \u043A\u0440\u043E\u0448\u0435\u0447\u043D\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u043E\u0439
      \u043D\u0430 \u0437\u0430\u0434\u043D\u0435\u043C \u043F\u043B\u0430\u043D\u0435
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0432\u044B\u0441\u043E\u043A\u0438\u043C
      \u043A\u0443\u0437\u0435\u043D\u043E\u043C \u2014 \u0434\u043E\u043A\u0442\u043E\u0440\u043E\u043C
      \u0422\u0430\u043F\u044C\u0435 \u0434\u0435 \u0421\u0435\u043B\u0435\u0439\u0440\u0430\u043D\u043E\u043C,
      \u0430 \u0441\u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u043C
      \u043F\u043B\u0430\u043D\u0435 \u0441 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u043C
      \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u044B\u043C \u043B\u0438\u0446\u043E\u043C
      \u2014 \u0442\u0430\u043D\u0446\u043E\u0432\u0449\u0438\u0446\u0430 \u041C\u044D\u0439
      \u041C\u0438\u043B\u044C\u0442\u043E\u043D."
    clip: {fileID: 8300000, guid: 32e1ab9630c435d40ba66485d21058f9, type: 3}
  - key: atalanta-and-hippomenes-reni
    sourceText: "\u0421\u044E\u0436\u0435\u0442 \u0432\u0437\u044F\u0442 \u0438\u0437
      \xAB\u041C\u0435\u0442\u0430\u043C\u043E\u0440\u0444\u043E\u0437\xBB \u041E\u0432\u0438\u0434\u0438\u044F:
      \u0445\u0438\u0442\u0440\u044B\u0439 \u0413\u0438\u043F\u043F\u043E\u043C\u0435\u043D
      \u043E\u0431\u0433\u043E\u043D\u044F\u0435\u0442 \u043D\u0435\u043F\u043E\u0431\u0435\u0434\u0438\u043C\u0443\u044E
      \u0431\u0435\u0433\u0443\u043D\u044C\u044E \u0410\u0442\u0430\u043B\u0430\u043D\u0442\u0443,
      \u043D\u0430 \u0431\u0435\u0433\u0443 \u0431\u0440\u043E\u0441\u0430\u044F
      \u0435\u0439 \u043F\u043E\u0434 \u043D\u043E\u0433\u0438 \u0437\u043E\u043B\u043E\u0442\u044B\u0435
      \u044F\u0431\u043B\u043E\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043E\u043D\u0430 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043D\u0435
      \u043F\u043E\u0434\u043D\u044F\u0442\u044C."
    clip: {fileID: 8300000, guid: f6c3fcc97c206ee4db67f83cd2cb7053, type: 3}
  - key: bacchus-and-ariadne
    sourceText: "\u0412 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438
      \u043D\u0435\u0431\u0430 \u0422\u0438\u0446\u0438\u0430\u043D \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B
      \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u0435 \u0421\u0435\u0432\u0435\u0440\u043D\u043E\u0439
      \u041A\u043E\u0440\u043E\u043D\u044B \u2014 \u043F\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0435,
      \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0443\u044E \u0412\u0430\u043A\u0445\u043E\u043C
      \u0432 \u043D\u0435\u0431\u043E \u043A\u043E\u0440\u043E\u043D\u0443 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u043E\u0439
      \u0410\u0440\u0438\u0430\u0434\u043D\u044B."
    clip: {fileID: 8300000, guid: 42422a31bb2f26b478c3034d2ac5129c, type: 3}
  - key: bal-du-moulin-de-la-galette
    sourceText: "\u0420\u0435\u043D\u0443\u0430\u0440 \u043F\u0438\u0441\u0430\u043B
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u043F\u0440\u044F\u043C\u043E \u043D\u0430
      \u043C\u0435\u0441\u0442\u0435 \u2014 \u0432 \u0441\u0430\u0434\u0443 \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u0430\u0431\u0430\u0440\u0435 \u043D\u0430 \u041C\u043E\u043D\u043C\u0430\u0440\u0442\u0440\u0435,
      \u0430 \u043C\u043E\u0434\u0435\u043B\u044F\u043C\u0438 \u0441\u0442\u0430\u043B\u0438
      \u0435\u0433\u043E \u0434\u0440\u0443\u0437\u044C\u044F-\u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0438
      \u0438 \u043F\u0430\u0440\u0438\u0436\u0441\u043A\u0438\u0435 \u043C\u043E\u0434\u0438\u0441\u0442\u043A\u0438,
      \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043F\u043E\u0445\u043E\u0436\u0438\u0445
      \u0434\u0440\u0443\u0433 \u043D\u0430 \u0434\u0440\u0443\u0433\u0430 \u0441\u0435\u0441\u0442\u0451\u0440
      \u0416\u0430\u043D\u043D\u0443 \u0438 \u042D\u0441\u0442\u0435\u043B\u044C."
    clip: {fileID: 8300000, guid: dfdb74d4a6efe2b4cac63f1c48b57e56, type: 3}
  - key: barge-haulers-on-the-volga
    sourceText: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u0438\u0441\u0430\u0442\u044C
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443, \u0420\u0435\u043F\u0438\u043D
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442 \u0435\u0437\u0434\u0438\u043B
      \u043D\u0430 \u0412\u043E\u043B\u0433\u0443 \u0438 \u0440\u0438\u0441\u043E\u0432\u0430\u043B
      \u0441 \u043D\u0430\u0442\u0443\u0440\u044B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445
      \u0431\u0443\u0440\u043B\u0430\u043A\u043E\u0432; \u0433\u043E\u0442\u043E\u0432\u043E\u0435
      \u043F\u043E\u043B\u043E\u0442\u043D\u043E \u043A\u0443\u043F\u0438\u043B \u0432\u0435\u043B\u0438\u043A\u0438\u0439
      \u043A\u043D\u044F\u0437\u044C \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440
      \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u0438\u0447,
      \u0431\u0440\u0430\u0442 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430."
    clip: {fileID: 8300000, guid: e6bf4ac8f5f6c704199fe81447b59551, type: 3}
  - key: bathers-at-asnieres
    sourceText: "\u0421\u0451\u0440\u0430 \u043F\u0438\u0441\u0430\u043B \u043A\u0430\u0440\u0442\u0438\u043D\u0443
      \u043D\u0435\u0437\u0430\u0434\u043E\u043B\u0433\u043E \u0434\u043E \xAB\u0412\u043E\u0441\u043A\u0440\u0435\u0441\u043D\u043E\u0433\u043E
      \u0434\u043D\u044F \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0435
      \u0413\u0440\u0430\u043D\u0434-\u0416\u0430\u0442\u0442\xBB: \u0444\u0438\u0433\u0443\u0440\u044B
      \u043A\u0443\u043F\u0430\u043B\u044C\u0449\u0438\u043A\u043E\u0432 \u043E\u043D
      \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0434\u0443\u043C\u044B\u0432\u0430\u043B
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u043D\u0430 \u044D\u0442\u044E\u0434\u0430\u0445,
      \u0430 \u0437\u0430\u0442\u0435\u043C \u0441\u043E\u0431\u0440\u0430\u043B
      \u0438\u0445 \u0432 \u0446\u0435\u043B\u044C\u043D\u0443\u044E \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044E
      \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u0421\u0435\u043D\u044B
      \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u0437\u0430\u0432\u043E\u0434\u0441\u043A\u0438\u0445
      \u0442\u0440\u0443\u0431 \u041A\u043B\u0438\u0448\u0438."
    clip: {fileID: 8300000, guid: 69ec354be25b00a4883d2e82a79c614b, type: 3}
  - key: birth-of-venus
    sourceText: "\u041F\u043E\u0437\u0430 \u0412\u0435\u043D\u0435\u0440\u044B \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442
      \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0430\u043D\u0442\u0438\u0447\u043D\u043E\u0439
      \u0441\u0442\u0430\u0442\u0443\u0438 \xAB\u0412\u0435\u043D\u0435\u0440\u044B
      \u0421\u0442\u044B\u0434\u043B\u0438\u0432\u043E\u0439\xBB, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439
      \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0443 \u043F\u043E \u043A\u043E\u043F\u0438\u044F\u043C."
    clip: {fileID: 8300000, guid: c61a8688ae8fd2040891c7fb73febb8f, type: 3}
  - key: bonaparte-crossing-the-alps
    sourceText: "\u0412 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u041D\u0430\u043F\u043E\u043B\u0435\u043E\u043D \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u043B
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u043D\u0430 \u043C\u0443\u043B\u0435,
      \u0432 \u0441\u0435\u0440\u043E\u043C \u043F\u043B\u0430\u0449\u0435 \u0438
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u043F\u043E\u0441\u043B\u0435 \u0441\u0432\u043E\u0435\u0439
      \u0430\u0440\u043C\u0438\u0438, \u043D\u043E \u043F\u043E \u0435\u0433\u043E
      \u043B\u0438\u0447\u043D\u043E\u043C\u0443 \u043F\u043E\u0436\u0435\u043B\u0430\u043D\u0438\u044E
      \u0414\u0430\u0432\u0438\u0434 \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B
      \u0435\u0433\u043E \u043D\u0430 \u0432\u0437\u0434\u044B\u0431\u043B\u0435\u043D\u043D\u043E\u043C
      \u043A\u043E\u043D\u0435 \u2014 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A
      \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u043F\u044F\u0442\u044C \u0432\u0435\u0440\u0441\u0438\u0439
      \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0430."
    clip: {fileID: 8300000, guid: 67aba058d99996a48b881460da6f6294, type: 3}
  - key: boulevard-montmartre-at-night
    sourceText: "\u042D\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u043D\u043E\u0447\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u0430
      \u0432 \u0441\u0435\u0440\u0438\u0438 \u0438\u0437 \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u0438
      \u0432\u0438\u0434\u043E\u0432 \u0431\u0443\u043B\u044C\u0432\u0430\u0440\u0430
      \u041C\u043E\u043D\u043C\u0430\u0440\u0442\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u041F\u0438\u0441\u0441\u0430\u0440\u0440\u043E \u043F\u0438\u0441\u0430\u043B
      \u0438\u0437 \u043E\u043A\u043D\u0430 \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0447\u043D\u043E\u0433\u043E
      \u043D\u043E\u043C\u0435\u0440\u0430 \u0432 \u0440\u0430\u0437\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u0441\u0443\u0442\u043E\u043A, \u0433\u043E\u0434\u0430
      \u0438 \u043F\u043E\u0433\u043E\u0434\u044B."
    clip: {fileID: 8300000, guid: e59fec3063c9b6b4e8a4c6d56b028463, type: 3}
  - key: cafe-terrace-at-night
    sourceText: "\u0412\u0430\u043D \u0413\u043E\u0433 \u043F\u0438\u0441\u0430\u043B
      \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0424\u043E\u0440\u0443\u043C\u0430
      \u0432 \u0410\u0440\u043B\u0435 \u043F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435
      \u0433\u0430\u0437\u043E\u0432\u044B\u0445 \u0444\u043E\u043D\u0430\u0440\u0435\u0439
      \u0438, \u043F\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0441\u043B\u043E\u0432\u0430\u043C, \u043E\u0431\u043E\u0448\u0451\u043B\u0441\u044F
      \u0431\u0435\u0437 \u0447\u0451\u0440\u043D\u043E\u0439 \u043A\u0440\u0430\u0441\u043A\u0438
      \u0432\u043E\u0432\u0441\u0435; \u044D\u0442\u043E \u043F\u0435\u0440\u0432\u0430\u044F
      \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \u0441\u043E \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u043C
      \u043D\u0435\u0431\u043E\u043C \u2014 \u043D\u0430 \u0433\u043E\u0434 \u0440\u0430\u043D\u044C\u0448\u0435
      \xAB\u0417\u0432\u0451\u0437\u0434\u043D\u043E\u0439 \u043D\u043E\u0447\u0438\xBB."
    clip: {fileID: 8300000, guid: d22f2b962d0c33a4e822cd30bd8bfb87, type: 3}
  - key: calling-of-saint-matthew
    sourceText: "\u0420\u0435\u0437\u043A\u0438\u0439 \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442
      \u0441\u0432\u0435\u0442\u0430 \u0438 \u0442\u0435\u043D\u0438 (\u043A\u044C\u044F\u0440\u043E\u0441\u043A\u0443\u0440\u043E)
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043B\u0443\u0447
      \u0441\u0432\u0435\u0442\u0430 \u043F\u0440\u044F\u043C\u043E \u043D\u0430
      \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E \u0430\u043F\u043E\u0441\u0442\u043E\u043B\u0430,
      \u0432\u044B\u0434\u0435\u043B\u044F\u044F \u043C\u043E\u043C\u0435\u043D\u0442
      \u0435\u0433\u043E \u043F\u0440\u0438\u0437\u0432\u0430\u043D\u0438\u044F."
    clip: {fileID: 8300000, guid: 98d4f42f4e7a7d3468d7862929dd5e9a, type: 3}
  - key: cornelia-mother-of-the-gracchi
    sourceText: "\u041A\u0430\u0443\u0444\u043C\u0430\u043D \u0431\u044B\u043B\u0430
      \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0434\u0432\u0443\u0445 \u0436\u0435\u043D\u0449\u0438\u043D
      \u0441\u0440\u0435\u0434\u0438 36 \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439
      \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439 \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0438
      \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432 \u0432 \u041B\u043E\u043D\u0434\u043E\u043D\u0435
      \u0432 \u0442\u044B\u0441\u044F\u0447\u0430 \u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u0448\u0435\u0441\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0432\u043E\u0441\u044C\u043C\u043E\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u0443; \u0441\u044E\u0436\u0435\u0442
      \u043A\u0430\u0440\u0442\u0438\u043D\u044B \u2014 \u0440\u0430\u0441\u0441\u043A\u0430\u0437
      \u043E \u0440\u0438\u043C\u043B\u044F\u043D\u043A\u0435 \u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0438,
      \u043F\u043E\u043A\u0430\u0437\u0430\u0432\u0448\u0435\u0439 \u0433\u043E\u0441\u0442\u044C\u0435
      \u0432\u043C\u0435\u0441\u0442\u043E \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0435\u0439
      \u0441\u0432\u043E\u0438\u0445 \u0441\u044B\u043D\u043E\u0432\u0435\u0439."
    clip: {fileID: 8300000, guid: 88c1cfddce476de42a3964144f7a8f75, type: 3}
  - key: creation-of-adam
    sourceText: "\u0424\u0440\u0435\u0441\u043A\u0430 \u0443\u043A\u0440\u0430\u0448\u0430\u0435\u0442
      \u043F\u043E\u0442\u043E\u043B\u043E\u043A \u0421\u0438\u043A\u0441\u0442\u0438\u043D\u0441\u043A\u043E\u0439
      \u043A\u0430\u043F\u0435\u043B\u043B\u044B; \u0432 \u0442\u044B\u0441\u044F\u0447\u0430
      \u0434\u0435\u0432\u044F\u0442\u044C\u0441\u043E\u0442 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u044B\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u0443 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439
      \u0432\u0440\u0430\u0447 \u0424\u0440\u044D\u043D\u043A \u041C\u0435\u0448\u0431\u0435\u0440\u0433\u0435\u0440
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B, \u0447\u0442\u043E \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F
      \u0444\u0438\u0433\u0443\u0440\u044B \u0411\u043E\u0433\u0430 \u0438 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0445
      \u0435\u0433\u043E \u0430\u043D\u0433\u0435\u043B\u043E\u0432 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0442
      \u0444\u043E\u0440\u043C\u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043C\u043E\u0437\u0433\u0430 \u0432 \u0440\u0430\u0437\u0440\u0435\u0437\u0435."
    clip: {fileID: 8300000, guid: df63bac75e739a2478f0fe0a75520782, type: 3}
  - key: dejeuner-sur-l-herbe
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0432\u044B\u0437\u0432\u0430\u043B\u0430
      \u0441\u043A\u0430\u043D\u0434\u0430\u043B \u0432 \u043F\u0430\u0440\u0438\u0436\u0441\u043A\u043E\u043C
      \u0421\u0430\u043B\u043E\u043D\u0435 \u043E\u0442\u0432\u0435\u0440\u0436\u0435\u043D\u043D\u044B\u0445
      \u0442\u044B\u0441\u044F\u0447\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u0448\u0435\u0441\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u0430 \u0438\u0437-\u0437\u0430 \u043E\u0431\u043D\u0430\u0436\u0451\u043D\u043D\u043E\u0439
      \u0436\u0435\u043D\u0449\u0438\u043D\u044B, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0441\u0438\u0434\u044F\u0449\u0435\u0439 \u0440\u044F\u0434\u043E\u043C \u0441
      \u043E\u0434\u0435\u0442\u044B\u043C\u0438 \u043F\u043E \u043C\u043E\u0434\u0435
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430\u043C\u0438."
    clip: {fileID: 8300000, guid: 95e98fadbd809a942b056b29a06cb6db, type: 3}
  - key: five-eldest-children-of-charles-i
    sourceText: "\u0412\u0430\u043D \u0414\u0435\u0439\u043A \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B
      \u0434\u0435\u0442\u0435\u0439 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u043A\u043E\u0440\u043E\u043B\u044F \u0436\u0438\u0432\u044B\u043C\u0438 \u0438
      \u043F\u043E-\u0434\u0435\u0442\u0441\u043A\u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438,
      \u043F\u043E\u0440\u0432\u0430\u0432 \u0441 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0435\u0439
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0432\u0435\u043D\u0446\u0435\u043D\u043E\u0441\u043D\u044B\u0445
      \u043E\u0442\u043F\u0440\u044B\u0441\u043A\u043E\u0432 \xAB\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C\u0438
      \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u043C\u0438\xBB."
    clip: {fileID: 8300000, guid: 2e85bb1517f02334590fac24b4a0ca58, type: 3}
  - key: garden-of-earthly-delights
    sourceText: "\u041E\u0431 \u044D\u0442\u043E\u043C \u0442\u0440\u0438\u043F\u0442\u0438\u0445\u0435
      \u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C
      \u043D\u0438 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430 \u043E \u0437\u0430\u043A\u0430\u0437\u0435,
      \u043D\u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u0438 \u0430\u0432\u0442\u043E\u0440\u0430,
      \u0430 \u0441\u043C\u044B\u0441\u043B \u0435\u0433\u043E \u0444\u0430\u043D\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432 \u2014 \u043E\u0442 \u0440\u0430\u0439\u0441\u043A\u043E\u0433\u043E
      \u0441\u0430\u0434\u0430 \u0434\u043E \u0430\u0434\u0430 \u2014 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u0432\u0435\u0434\u044B
      \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u044E\u0442 \u0434\u043E \u0441\u0438\u0445
      \u043F\u043E\u0440."
    clip: {fileID: 8300000, guid: edfe0ffe0be49c8499ec026ac8c66440, type: 3}
  - key: girl-with-a-pearl-earring
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0443 \u043D\u0435\u0440\u0435\u0434\u043A\u043E
      \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \xAB\u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439
      \u041C\u043E\u043D\u043E\u0439 \u041B\u0438\u0437\u043E\u0439\xBB: \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D\u043D\u043E\u0439 \u0434\u0435\u0432\u0443\u0448\u043A\u0438
      \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430."
    clip: {fileID: 8300000, guid: 1a68961af680d8347b4b896ffd2c94ef, type: 3}
  - key: great-wave-off-kanagawa
    sourceText: "\u042D\u0442\u043E \u043F\u0435\u0440\u0432\u0430\u044F \u0433\u0440\u0430\u0432\u044E\u0440\u0430
      \u0438\u0437 \u0441\u0435\u0440\u0438\u0438 \xAB\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0448\u0435\u0441\u0442\u044C \u0432\u0438\u0434\u043E\u0432 \u0424\u0443\u0434\u0437\u0438\xBB:
      \u0441\u0430\u043C\u0430 \u0433\u043E\u0440\u0430 \u0424\u0443\u0434\u0437\u0438
      \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0430 \u0432\u0434\u0430\u043B\u0438,
      \u043A\u0440\u043E\u0448\u0435\u0447\u043D\u043E\u0439 \u043D\u0430 \u0444\u043E\u043D\u0435
      \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u043E\u0439 \u0432\u043E\u043B\u043D\u044B."
    clip: {fileID: 8300000, guid: ff5185c7b7ad6cc4abaa5c648d9b85af, type: 3}
  - key: impression-sunrise
    sourceText: "\u0418\u043C\u0435\u043D\u043D\u043E \u043E\u0442 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      \u044D\u0442\u043E\u0439 \u043A\u0430\u0440\u0442\u0438\u043D\u044B \u043A\u0440\u0438\u0442\u0438\u043A
      \u041B\u0443\u0438 \u041B\u0435\u0440\u0443\u0430 \u043D\u0430\u0441\u043C\u0435\u0448\u043B\u0438\u0432\u043E
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043B \u0441\u043B\u043E\u0432\u043E
      \xAB\u0438\u043C\u043F\u0440\u0435\u0441\u0441\u0438\u043E\u043D\u0438\u0437\u043C\xBB,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0438
      \u043F\u043E\u0437\u0436\u0435 \u0441\u0430\u043C\u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u043A\u0430\u043A \u0438\u043C\u044F \u0442\u0435\u0447\u0435\u043D\u0438\u044F."
    clip: {fileID: 8300000, guid: 519985c26c3aeb34a8803f489a0c5848, type: 3}
  - key: judith-slaying-holofernes
    sourceText: "\u0414\u0436\u0435\u043D\u0442\u0438\u043B\u0435\u0441\u043A\u0438
      \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0430 \u044D\u0442\u0443 \u0441\u0446\u0435\u043D\u0443
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0435\u0442 \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E,
      \u043A\u0430\u043A \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0430 \u043D\u0430\u0441\u0438\u043B\u0438\u0435
      \u0438 \u0433\u0440\u043E\u043C\u043A\u0438\u0439 \u0441\u0443\u0434\u0435\u0431\u043D\u044B\u0439
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441, \u2014 \u043C\u043D\u043E\u0433\u0438\u0435
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u0432\u0435\u0434\u044B
      \u0432\u0438\u0434\u044F\u0442 \u0432 \u044F\u0440\u043E\u0441\u0442\u0438
      \u042E\u0434\u0438\u0444\u0438 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u043B\u0438\u0447\u043D\u043E\u0439 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u0446\u044B."
    clip: {fileID: 8300000, guid: d0bfddf34266f754ea92e0f7af773375, type: 3}
  - key: lady-with-an-ermine
    sourceText: "\u0418\u043D\u0444\u0440\u0430\u043A\u0440\u0430\u0441\u043D\u043E\u0435
      \u0441\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E,
      \u0447\u0442\u043E \u041B\u0435\u043E\u043D\u0430\u0440\u0434\u043E \u0434\u0432\u0430\u0436\u0434\u044B
      \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u044B\u0432\u0430\u043B \u043F\u043E\u0440\u0442\u0440\u0435\u0442
      \u0427\u0435\u0447\u0438\u043B\u0438\u0438 \u0413\u0430\u043B\u043B\u0435\u0440\u0430\u043D\u0438:
      \u0441\u043F\u0435\u0440\u0432\u0430 \u0437\u0432\u0435\u0440\u044C\u043A\u0430
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u043E\u0432\u0441\u0435, \u0437\u0430\u0442\u0435\u043C
      \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u0441\u0435\u0440\u044B\u0439 \u0437\u0432\u0435\u0440\u0451\u043A, \u0438
      \u043B\u0438\u0448\u044C \u043F\u043E\u0442\u043E\u043C \u2014 \u0431\u0435\u043B\u044B\u0439
      \u0433\u043E\u0440\u043D\u043E\u0441\u0442\u0430\u0439, \u043D\u0430\u043C\u0435\u043A\u0430\u0432\u0448\u0438\u0439
      \u043D\u0430 \u043F\u0440\u043E\u0437\u0432\u0438\u0449\u0435 \u043C\u0438\u043B\u0430\u043D\u0441\u043A\u043E\u0433\u043E
      \u0433\u0435\u0440\u0446\u043E\u0433\u0430 \u041B\u043E\u0434\u043E\u0432\u0438\u043A\u043E
      \u0421\u0444\u043E\u0440\u0446\u0430."
    clip: {fileID: 8300000, guid: e79890721921b724d9b0269d72767467, type: 3}
  - key: las-meninas
    sourceText: "\u0412\u0435\u043B\u0430\u0441\u043A\u0435\u0441 \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B
      \u0441\u0430\u043C\u043E\u0433\u043E \u0441\u0435\u0431\u044F \u0441\u0442\u043E\u044F\u0449\u0438\u043C
      \u0443 \u043C\u043E\u043B\u044C\u0431\u0435\u0440\u0442\u0430 \u2014 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0440\u0430\u043D\u043D\u0438\u0445
      \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u0432 \u0441\u0442\u043E\u043B\u044C
      \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u043D\u043E\u0439 \xAB\u043A\u0430\u0440\u0442\u0438\u043D\u044B
      \u0432 \u043A\u0430\u0440\u0442\u0438\u043D\u0435\xBB."
    clip: {fileID: 8300000, guid: fc6c7880946dab447849760a40484ff6, type: 3}
  - key: last-supper
    sourceText: "\u041B\u0435\u043E\u043D\u0430\u0440\u0434\u043E \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043B
      \u0441\u0442\u0435\u043D\u0443 \u043D\u0435 \u0444\u0440\u0435\u0441\u043A\u043E\u0439
      \u043F\u043E \u043C\u043E\u043A\u0440\u043E\u0439 \u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u043A\u0435,
      \u0430 \u0442\u0435\u043C\u043F\u0435\u0440\u043E\u0439 \u0438 \u043C\u0430\u0441\u043B\u043E\u043C
      \u043F\u043E \u0441\u0443\u0445\u043E\u0439 \u0433\u0440\u0443\u043D\u0442\u043E\u0432\u043A\u0435
      \u2014 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442 \u0434\u0430\u043B
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u044B
      \u0432 \u0434\u0435\u0442\u0430\u043B\u044F\u0445, \u043D\u043E \u0440\u043E\u0441\u043F\u0438\u0441\u044C
      \u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0441\u044B\u043F\u0430\u0442\u044C\u0441\u044F
      \u0443\u0436\u0435 \u043F\u0440\u0438 \u0436\u0438\u0437\u043D\u0438 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430."
    clip: {fileID: 8300000, guid: 1da52b8d49ff4644ea4e471104af0c29, type: 3}
  - key: liberty-leading-the-people
    sourceText: "\u0416\u0435\u043D\u0449\u0438\u043D\u0430 \u0441 \u0444\u043B\u0430\u0433\u043E\u043C
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u043C \u043F\u043B\u0430\u043D\u0435
      \u2014 \u0430\u043B\u043B\u0435\u0433\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0421\u0432\u043E\u0431\u043E\u0434\u0430, \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u0451\u043D\u043D\u0430\u044F
      \u043E\u0431\u0440\u0430\u0437\u043E\u043C \u041C\u0430\u0440\u0438\u0430\u043D\u043D\u044B,
      \u0441\u0438\u043C\u0432\u043E\u043B\u0430 \u0424\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u0439
      \u0440\u0435\u0441\u043F\u0443\u0431\u043B\u0438\u043A\u0438."
    clip: {fileID: 8300000, guid: b02c4bdff4360cb409adf8640a59f27f, type: 3}
  - key: little-girl-in-a-blue-armchair
    sourceText: "\u041A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044E \u043A\u0430\u0440\u0442\u0438\u043D\u044B
      \u041A\u0430\u0441\u0441\u0430\u0442 \u043F\u043E\u043C\u043E\u0433 \u0434\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0414\u0435\u0433\u0430: \u0438\u043D\u0444\u0440\u0430\u043A\u0440\u0430\u0441\u043D\u044B\u0435
      \u0441\u043D\u0438\u043C\u043A\u0438 \u041D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
      \u0433\u0430\u043B\u0435\u0440\u0435\u0438 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438, \u0447\u0442\u043E
      \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u043D \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u043B\u0430 \u0438 \u043F\u0440\u0438\u0434\u0430\u043B
      \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443 \u043C\u0435\u0436\u0434\u0443
      \u043A\u0440\u0435\u0441\u043B\u0430\u043C\u0438 \u0431\u043E\u043B\u0435\u0435
      \u0441\u043C\u0435\u043B\u044B\u0439, \u0430\u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u044B\u0439
      \u0440\u0430\u043A\u0443\u0440\u0441."
    clip: {fileID: 8300000, guid: 48110483386cb9d4f981a147ede73248, type: 3}
  - key: luncheon-of-the-boating-party
    sourceText: "\u041D\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u044B
      \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u0440\u0443\u0437\u044C\u044F
      \u0420\u0435\u043D\u0443\u0430\u0440\u0430, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
      \u0435\u0433\u043E \u0431\u0443\u0434\u0443\u0449\u0443\u044E \u0436\u0435\u043D\u0443
      \u0410\u043B\u0438\u043D\u0443 \u0428\u0430\u0440\u0438\u0433\u043E, \u0438\u0433\u0440\u0430\u044E\u0449\u0443\u044E
      \u0441 \u0441\u043E\u0431\u0430\u0447\u043A\u043E\u0439 \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u043C
      \u043F\u043B\u0430\u043D\u0435."
    clip: {fileID: 8300000, guid: 8f3261886922b1d4789346d7b6b25251, type: 3}
  - key: massacre-of-the-innocents-rubens
    sourceText: "\u0414\u043E \u0434\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0433\u043E\u0434 \u0433\u043E\u0434\u0430
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u043F\u0440\u0438\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0438
      \u0432\u0442\u043E\u0440\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u044B\u043C
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430\u043C, \u0430 \u0432 \u0434\u0432\u0435
      \u0442\u044B\u0441\u044F\u0447\u0438 \u0432\u0442\u043E\u0440\u043E\u0439 \u0433\u043E\u0434
      \u0433\u043E\u0434\u0443, \u0443\u0436\u0435 \u043A\u0430\u043A \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u0438\u043A
      \u0420\u0443\u0431\u0435\u043D\u0441\u0430, \u043E\u043D\u0430 \u0431\u044B\u043B\u0430
      \u043F\u0440\u043E\u0434\u0430\u043D\u0430 \u043D\u0430 Sotheby's \u0437\u0430
      49,5 \u043C\u043B\u043D \u0444\u0443\u043D\u0442\u043E\u0432 \u2014 \u0440\u0435\u043A\u043E\u0440\u0434\u043D\u0430\u044F
      \u043D\u0430 \u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442 \u0446\u0435\u043D\u0430
      \u0434\u043B\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u044B \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430."
    clip: {fileID: 8300000, guid: 6e0c6eae8bc2e254f85a33550c4981df, type: 3}
  - key: mona-lisa
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
      \u0432 \u041B\u0443\u0432\u0440\u0435 \u043F\u043E\u0434 \u043F\u0443\u043B\u0435\u043D\u0435\u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u044B\u043C
      \u0441\u0442\u0435\u043A\u043B\u043E\u043C \u0438 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0441\u0430\u043C\u043E\u0439 \u043F\u043E\u0441\u0435\u0449\u0430\u0435\u043C\u043E\u0439
      \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u0439 \u0432 \u043C\u0438\u0440\u0435."
    clip: {fileID: 8300000, guid: 48ccf067f392b5740bb1d7645e00d37f, type: 3}
  - key: napoleon-on-his-imperial-throne
    sourceText: "\u0425\u0438\u0435\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u043F\u043E\u0437\u0430 \u041D\u0430\u043F\u043E\u043B\u0435\u043E\u043D\u0430
      \u043D\u0430 \u0442\u0440\u043E\u043D\u0435 \u0432\u043E\u0441\u0445\u043E\u0434\u0438\u0442
      \u043A \u0430\u043D\u0442\u0438\u0447\u043D\u044B\u043C \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F\u043C
      \u0417\u0435\u0432\u0441\u0430 \u0438 \u0441\u0440\u0435\u0434\u043D\u0435\u0432\u0435\u043A\u043E\u0432\u044B\u043C
      \u043E\u0431\u0440\u0430\u0437\u0430\u043C \u0425\u0440\u0438\u0441\u0442\u0430
      \u0432\u043E \u0441\u043B\u0430\u0432\u0435; \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u0438
      \u043D\u0430\u0448\u043B\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0430\u0440\u0445\u0430\u0438\u0447\u043D\u043E\u0439 \u0438 \xAB\u0433\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439\xBB."
    clip: {fileID: 8300000, guid: 046fdeb80aa552740ad02b7534981b60, type: 3}
  - key: oath-of-the-horatii
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u043B\u044F\u0435\u0442
      \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0439 \u0434\u043E\u043B\u0433
      \u0438 \u0441\u0430\u043C\u043E\u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435
      \u0440\u0438\u043C\u043B\u044F\u043D \u0438 \u0441\u0442\u0430\u043B\u0430
      \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u043C \u043C\u0430\u043D\u0438\u0444\u0435\u0441\u0442\u043E\u043C
      \u0438\u0434\u0435\u0430\u043B\u043E\u0432 \u043D\u0430\u043A\u0430\u043D\u0443\u043D\u0435
      \u0424\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u0439 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438."
    clip: {fileID: 8300000, guid: 7df2d8cfd942d24459dfff692b35a073, type: 3}
  - key: pinkie-sarah-barrett-moulton
    sourceText: "\u041F\u043E\u0440\u0442\u0440\u0435\u0442 \u043E\u0434\u0438\u043D\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043B\u0435\u0442\u043D\u0435\u0439
      \u0421\u0430\u0440\u044B \u0411\u0430\u0440\u0440\u0435\u0442 \u041C\u0443\u043B\u0442\u043E\u043D
      \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438
      \u043D\u0430 \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0435 \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439
      \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0438, \u043E\u0442\u043A\u0440\u044B\u0432\u0448\u0435\u0439\u0441\u044F
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0434\u0435\u043D\u044C
      \u043F\u043E\u0441\u043B\u0435 \u0435\u0451 \u043F\u043E\u0445\u043E\u0440\u043E\u043D:
      \u0434\u0435\u0432\u043E\u0447\u043A\u0430 \u0443\u043C\u0435\u0440\u043B\u0430
      \u043E\u0442 \u0447\u0430\u0445\u043E\u0442\u043A\u0438, \u043D\u0435 \u0434\u043E\u0436\u0438\u0432
      \u0434\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u044B
      \u043D\u0430\u0434 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u0439."
    clip: {fileID: 8300000, guid: a735c1a4cdec45042b94acef2e9ce3f0, type: 3}
  - key: portrait-of-a-man-in-a-red-turban
    sourceText: "\u041D\u0430 \u0440\u0430\u043C\u0435 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A
      \u043A\u0440\u0443\u043F\u043D\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u0441\u0432\u043E\u0439 \u0434\u0435\u0432\u0438\u0437 \xABALS ICH KAN\xBB
      (\xAB\u043A\u0430\u043A \u044F \u0443\u043C\u0435\u044E\xBB \u2014 \u0438\u0433\u0440\u0430
      \u0441\u043B\u043E\u0432 \u0441 \u0435\u0433\u043E \u0438\u043C\u0435\u043D\u0435\u043C),
      \u0430 \u043F\u0440\u044F\u043C\u043E\u0439 \u0432\u0437\u0433\u043B\u044F\u0434
      \u043C\u043E\u0434\u0435\u043B\u0438 \u043D\u0430 \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u0432\u0435\u0434\u043E\u0432
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0438\u043D\u0443
      \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445
      \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0445 \u0430\u0432\u0442\u043E\u043F\u043E\u0440\u0442\u0440\u0435\u0442\u043E\u0432."
    clip: {fileID: 8300000, guid: c10cfe745f2a7e04e86ffe13ea65d55f, type: 3}
  - key: portrait-of-adele-bloch-bauer-i
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0443, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \xAB\u0416\u0435\u043D\u0449\u0438\u043D\u0430
      \u0432 \u0437\u043E\u043B\u043E\u0442\u0435\xBB, \u043D\u0430\u0446\u0438\u0441\u0442\u044B
      \u043E\u0442\u043E\u0431\u0440\u0430\u043B\u0438 \u0443 \u0441\u0435\u043C\u044C\u0438
      \u0411\u043B\u043E\u0445-\u0411\u0430\u0443\u044D\u0440 \u0432 \u0442\u044B\u0441\u044F\u0447\u0430
      \u0434\u0435\u0432\u044F\u0442\u044C\u0441\u043E\u0442 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0432\u043E\u0441\u044C\u043C\u043E\u0439 \u0433\u043E\u0434 \u0433\u043E\u0434\u0443;
      \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u043E\u0439 \u0441\u0443\u0434\u0435\u0431\u043D\u043E\u0439
      \u0442\u044F\u0436\u0431\u044B \u043E\u043D\u0430 \u0431\u044B\u043B\u0430
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0430 \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u0446\u0435
      \u0438 \u0432 \u0434\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438 \u0448\u0435\u0441\u0442\u043E\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u0443 \u043F\u0440\u043E\u0434\u0430\u043D\u0430
      \u0437\u0430 \u0441\u0442\u043E \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u043F\u044F\u0442\u044B\u0439 \u0433\u043E\u0434 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432
      \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432."
    clip: {fileID: 8300000, guid: 65ba61d34196e0246b3f98a8511b0829, type: 3}
  - key: portrait-of-erasmus
    sourceText: "\u0413\u043E\u043B\u044C\u0431\u0435\u0439\u043D \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u043F\u0438\u0439
      \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u042D\u0440\u0430\u0437\u043C \u0440\u0430\u0441\u0441\u044B\u043B\u0430\u043B
      \u0434\u0440\u0443\u0437\u044C\u044F\u043C-\u0433\u0443\u043C\u0430\u043D\u0438\u0441\u0442\u0430\u043C
      \u043F\u043E \u0432\u0441\u0435\u0439 \u0415\u0432\u0440\u043E\u043F\u0435,
      \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0422\u043E\u043C\u0430\u0441\u0430
      \u041C\u043E\u0440\u0430, \u2014 \u0442\u0430\u043A \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u0443\u0447\u0451\u043D\u044B\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B
      \u0434\u0440\u0443\u0436\u0431\u0443 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438."
    clip: {fileID: 8300000, guid: 161ab9a144bbf854a90517ea7b069071, type: 3}
  - key: portrait-of-innocent-x
    sourceText: "\u0423\u0432\u0438\u0434\u0435\u0432 \u0433\u043E\u0442\u043E\u0432\u044B\u0439
      \u043F\u043E\u0440\u0442\u0440\u0435\u0442, \u0441\u0430\u043C \u043F\u0430\u043F\u0430
      \u0418\u043D\u043D\u043E\u043A\u0435\u043D\u0442\u0438\u0439 X \u0431\u0443\u0434\u0442\u043E
      \u0431\u044B \u043D\u0430\u0437\u0432\u0430\u043B \u0435\u0433\u043E \xAB\u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043F\u0440\u0430\u0432\u0434\u0438\u0432\u044B\u043C\xBB \u2014 \u0412\u0435\u043B\u0430\u0441\u043A\u0435\u0441
      \u043D\u0435 \u0441\u043C\u044F\u0433\u0447\u0438\u043B \u043D\u0438 \u043E\u0434\u043D\u043E\u0439
      \u043C\u043E\u0440\u0449\u0438\u043D\u044B \u0441\u0442\u0430\u0440\u0435\u044E\u0449\u0435\u0433\u043E
      \u043F\u043E\u043D\u0442\u0438\u0444\u0438\u043A\u0430."
    clip: {fileID: 8300000, guid: 6eda1c82e92f0df4185e555378556c55, type: 3}
  - key: portrait-of-wally-neuzil
    sourceText: "\u0412\u0430\u043B\u043B\u0438 \u041D\u043E\u0439\u0446\u0438\u043B\u044C
      \u0431\u044B\u043B\u0430 \u0431\u043B\u0438\u0437\u043A\u043E\u0439 \u0441\u043F\u0443\u0442\u043D\u0438\u0446\u0435\u0439
      \u0438 \u043C\u0443\u0437\u043E\u0439 \u0428\u0438\u043B\u0435; \u0441\u0430\u043C
      \u043F\u043E\u0440\u0442\u0440\u0435\u0442 \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442
      \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
      \u0433\u0440\u043E\u043C\u043A\u043E\u0433\u043E \u0441\u0443\u0434\u0435\u0431\u043D\u043E\u0433\u043E
      \u0441\u043F\u043E\u0440\u0430 \u043E \u043D\u0430\u0446\u0438\u0441\u0442\u0441\u043A\u0438\u0445
      \u0442\u0440\u043E\u0444\u0435\u0439\u043D\u044B\u0445 \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044F\u0445
      \u0432 \u0421\u0428\u0410, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B\u0441\u044F
      \u043B\u0438\u0448\u044C \u0432 \u0434\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438
      \u0434\u0435\u0441\u044F\u0442\u044B\u0439 \u0433\u043E\u0434 \u0433\u043E\u0434\u0443
      \u0432\u044B\u043F\u043B\u0430\u0442\u043E\u0439 19 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432
      \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432."
    clip: {fileID: 8300000, guid: 2758a1bb6366f734e98bddc4c77858cf, type: 3}
  - key: primavera
    sourceText: "\u0411\u043E\u0442\u0430\u043D\u0438\u043A\u0438 \u043D\u0430\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u0435 \u0441\u0432\u044B\u0448\u0435
      \u043F\u044F\u0442\u044C\u0441\u043E\u0442 \u0433\u043E\u0434 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439
      \u0438 \u043E\u043A\u043E\u043B\u043E \u0441\u0442\u0430 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E\u0433\u043E
      \u0433\u043E\u0434\u0430 \u0432\u0438\u0434\u043E\u0432 \u0446\u0432\u0435\u0442\u043E\u0432,
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0445 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E \u0443\u0447\u0451\u043D\u044B\u0435
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442 \u0435\u0451 \u043A\u0430\u043A
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0434\u043B\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u0444\u043B\u043E\u0440\u044B \u0422\u043E\u0441\u043A\u0430\u043D\u044B."
    clip: {fileID: 8300000, guid: d12765afaa82cfc4bacc55911aa90357, type: 3}
  - key: rape-of-the-sabine-women-poussin
    sourceText: "\u042D\u0442\u043E \u0443\u0436\u0435 \u0432\u0442\u043E\u0440\u0430\u044F
      \u0432\u0435\u0440\u0441\u0438\u044F \u0441\u044E\u0436\u0435\u0442\u0430 \u0443
      \u041F\u0443\u0441\u0441\u0435\u043D\u0430 \u2014 \u0431\u043E\u043B\u0435\u0435
      \u0440\u0430\u043D\u043D\u044E\u044E, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u0443\u044E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438 \u0433\u043E\u0434\u0430\u043C\u0438
      \u0440\u0430\u043D\u0435\u0435 \u0432 \u0420\u0438\u043C\u0435, \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043C\u043E\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0432
      \u041C\u0435\u0442\u0440\u043E\u043F\u043E\u043B\u0438\u0442\u0435\u043D-\u043C\u0443\u0437\u0435\u0435
      \u0432 \u041D\u044C\u044E-\u0419\u043E\u0440\u043A\u0435."
    clip: {fileID: 8300000, guid: dcb40c0863af1ef4280df4ef3bc86b34, type: 3}
  - key: red-fuji
    sourceText: "\u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \xAB\u0411\u043E\u043B\u044C\u0448\u043E\u0439
      \u0432\u043E\u043B\u043D\u044B\xBB \u0438\u0437 \u0442\u043E\u0439 \u0436\u0435
      \u0441\u0435\u0440\u0438\u0438, \u0437\u0434\u0435\u0441\u044C \u0425\u043E\u043A\u0443\u0441\u0430\u0439
      \u043E\u0431\u043E\u0448\u0451\u043B\u0441\u044F \u0432\u0441\u0435\u0433\u043E
      \u0442\u0440\u0435\u043C\u044F \u043A\u0440\u0430\u0441\u043A\u0430\u043C\u0438
      \u0438 \u043D\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B
      \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u2014 \u0432\u0441\u0451 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043E\u0442\u0434\u0430\u043D\u043E \u0433\u043E\u0440\u0435 \u0424\u0443\u0434\u0437\u0438
      \u0432 \u043B\u0443\u0447\u0430\u0445 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430."
    clip: {fileID: 8300000, guid: 782b195120709cf43b4583493f1e4258, type: 3}
  - key: regentesses-of-the-old-mens-almshouse
    sourceText: "\u0425\u0430\u043B\u044C\u0441 \u043F\u0438\u0441\u0430\u043B \u044D\u0442\u0443
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0432 81 \u0433\u043E\u0434, \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043D\u0438\u0449\u0438\u043C \u0438 \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D\u043D\u044B\u043C
      \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C \u0440\u0430\u0441\u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u0437\u0430 \u0434\u043E\u043B\u0433\u0438,
      \u2014 \u043E\u0442\u0441\u044E\u0434\u0430 \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E
      \u0433\u0440\u0443\u0431\u0430\u044F \u0438 \u0440\u0430\u0437\u043C\u0430\u0448\u0438\u0441\u0442\u0430\u044F
      \u043C\u0430\u043D\u0435\u0440\u0430 \u043F\u0438\u0441\u044C\u043C\u0430.
      \u041F\u043E\u043B\u043E\u0442\u043D\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u043E
      \u0434\u043B\u044F \u0445\u0430\u0440\u043B\u0435\u043C\u0441\u043A\u043E\u0439
      \u0431\u043E\u0433\u0430\u0434\u0435\u043B\u044C\u043D\u0438, \u0437\u0434\u0430\u043D\u0438\u0435
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u041C\u0443\u0437\u0435\u0439
      \u0424\u0440\u0430\u043D\u0441\u0430 \u0425\u0430\u043B\u044C\u0441\u0430."
    clip: {fileID: 8300000, guid: 3df2ea58d1ee49e489b060ceab6f0880, type: 3}
  - key: rembrandt-self-portrait
    sourceText: "\u0417\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0434\u0432\u0443\u0445
      \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0445 \u043A\u0440\u0443\u0433\u043E\u0432
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
      \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430 \u0434\u043E \u0441\u0438\u0445
      \u043F\u043E\u0440 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043C
      \u0441\u043F\u043E\u0440\u043E\u0432 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u0432\u0435\u0434\u043E\u0432."
    clip: {fileID: 8300000, guid: 80e17232bc9a28048aa29c742462877e, type: 3}
  - key: rubens-isabella-brant-honeysuckle-bower
    sourceText: "\u0420\u0443\u0431\u0435\u043D\u0441 \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u044D\u0442\u043E\u0442 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u043F\u043E\u0440\u0442\u0440\u0435\u0442
      \u0432\u0441\u043A\u043E\u0440\u0435 \u043F\u043E\u0441\u043B\u0435 \u0441\u0432\u0430\u0434\u044C\u0431\u044B
      \u0441 \u0418\u0437\u0430\u0431\u0435\u043B\u043B\u043E\u0439 \u0411\u0440\u0430\u043D\u0442:
      \u0441\u043F\u043B\u0435\u0442\u0451\u043D\u043D\u044B\u0435 \u0440\u0443\u043A\u0438
      \u0441\u0443\u043F\u0440\u0443\u0433\u043E\u0432 \u0438 \u043A\u0443\u0441\u0442
      \u0436\u0438\u043C\u043E\u043B\u043E\u0441\u0442\u0438 \u043D\u0430\u0434 \u043D\u0438\u043C\u0438
      \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0442
      \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C \u0438 \u0441\u0435\u043C\u0435\u0439\u043D\u043E\u0435
      \u0441\u0447\u0430\u0441\u0442\u044C\u0435."
    clip: {fileID: 8300000, guid: b883a93772d5f624581e04f5538cba9d, type: 3}
  - key: saint-serapion
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044C
      \u0434\u043B\u044F \u0442\u0440\u0430\u0443\u0440\u043D\u043E\u0433\u043E \u0437\u0430\u043B\u0430
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F \u043C\u0435\u0440\u0441\u0435\u0434\u0430\u0440\u0438\u0435\u0432
      \u0432 \u0421\u0435\u0432\u0438\u043B\u044C\u0435: \u0421\u0443\u0440\u0431\u0430\u0440\u0430\u043D
      \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0443\u0431\u0440\u0430\u043B \u043A\u0440\u043E\u0432\u044C \u0438 \u0440\u0430\u043D\u044B,
      \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0432\u0448\u0438\u0441\u044C
      \u043D\u0430 \u0431\u0435\u043B\u043E\u0439 \u0434\u0440\u0430\u043F\u0438\u0440\u043E\u0432\u043A\u0435
      \u043E\u0434\u0435\u044F\u043D\u0438\u044F \u0438 \u0442\u0438\u0448\u0438\u043D\u0435
      \u0441\u043C\u0435\u0440\u0442\u0438."
    clip: {fileID: 8300000, guid: 10a2bcd0659350645a465a99d83078a7, type: 3}
  - key: saturn-devouring-his-son
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0432\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0441\u0435\u0440\u0438\u044E \u0438\u0437 14 \xAB\u0427\u0451\u0440\u043D\u044B\u0445
      \u043A\u0430\u0440\u0442\u0438\u043D\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0413\u043E\u0439\u044F \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445 \u0441\u0432\u043E\u0435\u0433\u043E
      \u0434\u043E\u043C\u0430 \u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0430\u043B
      \u0434\u043B\u044F \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E\u0433\u043E
      \u043F\u043E\u043A\u0430\u0437\u0430."
    clip: {fileID: 8300000, guid: c2a4e34696cdcca43ae83779742771d4, type: 3}
  - key: school-of-athens
    sourceText: "\u0420\u0430\u0444\u0430\u044D\u043B\u044C \u043F\u0440\u0438\u0434\u0430\u043B
      \u0430\u043D\u0442\u0438\u0447\u043D\u044B\u043C \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0430\u043C
      \u0447\u0435\u0440\u0442\u044B \u0441\u0432\u043E\u0438\u0445 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u043E\u0432:
      \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
      \u041F\u043B\u0430\u0442\u043E\u043D \u043D\u0430 \u0444\u0440\u0435\u0441\u043A\u0435
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D \u043F\u043E\u0445\u043E\u0436\u0438\u043C
      \u043D\u0430 \u041B\u0435\u043E\u043D\u0430\u0440\u0434\u043E \u0434\u0430
      \u0412\u0438\u043D\u0447\u0438."
    clip: {fileID: 8300000, guid: 9a33ba03043b0a14c9e17c7687a9ee8d, type: 3}
  - key: self-portrait-allegory-of-painting
    sourceText: "\u041F\u043E \u043A\u0430\u043D\u043E\u043D\u0443 \u044D\u043F\u043E\u0445\u0438
      \u0430\u043B\u043B\u0435\u0433\u043E\u0440\u0438\u044F \u0416\u0438\u0432\u043E\u043F\u0438\u0441\u0438
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u043B\u0430\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0436\u0435\u043D\u0441\u043A\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u043E\u0439
      \u2014 \u0414\u0436\u0435\u043D\u0442\u0438\u043B\u0435\u0441\u043A\u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u0446\u0435\u0439
      \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0439 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0441\u0442\u0430\u0442\u044C \u044D\u0442\u043E\u0439 \u0430\u043B\u043B\u0435\u0433\u043E\u0440\u0438\u0435\u0439
      \u0432 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C \u0430\u0432\u0442\u043E\u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0435."
    clip: {fileID: 8300000, guid: 28974664a50800841b4505806ac7425d, type: 3}
  - key: sistine-madonna
    sourceText: "\u0414\u0432\u0430 \u0437\u0430\u0434\u0443\u043C\u0447\u0438\u0432\u044B\u0445
      \u0430\u043D\u0433\u0435\u043B\u043E\u0447\u043A\u0430 \u0443 \u043D\u0438\u0436\u043D\u0435\u0433\u043E
      \u043A\u0440\u0430\u044F \u0445\u043E\u043B\u0441\u0442\u0430 \u0434\u0430\u0432\u043D\u043E
      \u0436\u0438\u0432\u0443\u0442 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u0436\u0438\u0437\u043D\u044C\u044E: \u0438\u0445 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u0436\u0438\u0440\u043E\u0432\u0430\u043D\u043E
      \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043A\u0430\u0445, \u043E\u0431\u0451\u0440\u0442\u043E\u0447\u043D\u043E\u0439
      \u0431\u0443\u043C\u0430\u0433\u0435 \u0438 \u0441\u0443\u0432\u0435\u043D\u0438\u0440\u0430\u0445
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u043E\u0442 \u0432\u0441\u0435\u0439
      \u043A\u0430\u0440\u0442\u0438\u043D\u044B."
    clip: {fileID: 8300000, guid: 38fb071d6ede0e84eab913419e0113a7, type: 3}
  - key: starry-night
    sourceText: "\u0412\u0430\u043D \u0413\u043E\u0433 \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u043F\u043E
      \u043F\u0430\u043C\u044F\u0442\u0438 \u0438 \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044E
      \u0432 \u043F\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u043B\u0435\u0447\u0435\u0431\u043D\u0438\u0446\u0435 \u0421\u0435\u043D-\u0420\u0435\u043C\u0438,
      \u043E\u0442\u0447\u0430\u0441\u0442\u0438 \u043E\u043F\u0438\u0440\u0430\u044F\u0441\u044C
      \u043D\u0430 \u0432\u0438\u0434 \u0438\u0437 \u043E\u043A\u043D\u0430 \u0441\u0432\u043E\u0435\u0439
      \u043F\u0430\u043B\u0430\u0442\u044B."
    clip: {fileID: 8300000, guid: 3a309ce650c8d884fbefbb084acb3087, type: 3}
  - key: still-life-with-a-nautilus-cup
    sourceText: "\u0420\u0430\u043A\u043E\u0432\u0438\u043D\u0443 \u0441\u043E\u0437\u0434\u0430\u043B\u0430
      \u043F\u0440\u0438\u0440\u043E\u0434\u0430, \u0440\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u0438\u043A
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B \u0435\u0451 \u0432
      \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0439 \u043A\u0443\u0431\u043E\u043A,
      \u0430 \u041A\u0430\u043B\u044C\u0444 \u2014 \u0432 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438: \u044D\u0442\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u043D\u0430\u044F
      \u0438 \u0434\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430 \u0441\u043B\u0443\u0436\u0438\u0442 \u043E\u043F\u043E\u0440\u043D\u043E\u0439
      \u0442\u043E\u0447\u043A\u043E\u0439 \u0434\u043B\u044F \u0434\u0430\u0442\u0438\u0440\u043E\u0432\u043A\u0438
      \u0432\u0441\u0435\u0433\u043E \u0435\u0433\u043E \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430.
      \u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u043A\u043E\u0432\u0451\u0440
      \u0438 \u043B\u0438\u043C\u043E\u043D, \u043E\u0447\u0438\u0449\u0435\u043D\u043D\u044B\u0439
      \u043F\u043E \u0441\u043F\u0438\u0440\u0430\u043B\u0438, \u2014 \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u044B\u0435
      \u043F\u0440\u0438\u0451\u043C\u044B \xAB\u043F\u0440\u0443\u043D\u043A\xBB-\u043D\u0430\u0442\u044E\u0440\u043C\u043E\u0440\u0442\u043E\u0432
      \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430."
    clip: {fileID: 8300000, guid: 6b0be4afeeb95aa4cb93806b2fb4acdd, type: 3}
  - key: sudden-shower-over-shin-ohashi-bridge
    sourceText: "\u041B\u0438\u0432\u0435\u043D\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u043D
      \u0434\u0435\u0441\u044F\u0442\u043A\u0430\u043C\u0438 \u0442\u043E\u043D\u043A\u0438\u0445
      \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u044B\u0445 \u043B\u0438\u043D\u0438\u0439,
      \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0445 \u043D\u0430 \u043F\u0435\u0447\u0430\u0442\u043D\u043E\u0439
      \u0434\u043E\u0441\u043A\u0435; \u044D\u0442\u043E\u0442 \u043F\u0440\u0438\u0451\u043C
      \u0432 \u0442\u044B\u0441\u044F\u0447\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u0432\u043E\u0441\u0435\u043C\u044C\u0434\u0435\u0441\u044F\u0442 \u0441\u0435\u0434\u044C\u043C\u043E\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u0443 \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043B
      \u043C\u0430\u0441\u043B\u043E\u043C \u0412\u0438\u043D\u0441\u0435\u043D\u0442
      \u0432\u0430\u043D \u0413\u043E\u0433 \u0432 \u0441\u0432\u043E\u0435\u0439
      \u043A\u0430\u0440\u0442\u0438\u043D\u0435 \xAB\u041C\u043E\u0441\u0442 \u0432
      \u0434\u043E\u0436\u0434\u044C\xBB."
    clip: {fileID: 8300000, guid: c081b7cbf11f2b3479d850ac8b0f0d81, type: 3}
  - key: sunday-afternoon-la-grande-jatte
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0446\u0435\u043B\u0438\u043A\u043E\u043C
      \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u0442\u044B\u0441\u044F\u0447
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u0446\u0432\u0435\u0442\u043D\u044B\u0445
      \u0442\u043E\u0447\u0435\u043A \u2014 \u0442\u0435\u0445\u043D\u0438\u043A\u0430,
      \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0430\u044F \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u043F\u0443\u0430\u043D\u0442\u0438\u043B\u0438\u0437\u043C, \u0438\u043B\u0438
      \u0434\u0438\u0432\u0438\u0437\u0438\u043E\u043D\u0438\u0437\u043C."
    clip: {fileID: 8300000, guid: 461310d4a7ffa0e48800f3da56c1db63, type: 3}
  - key: sunflowers
    sourceText: "\u0412\u0430\u043D \u0413\u043E\u0433 \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u0441\u0435\u0440\u0438\u044E \u043A\u0430\u0440\u0442\u0438\u043D \u0441
      \u043F\u043E\u0434\u0441\u043E\u043B\u043D\u0443\u0445\u0430\u043C\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0443\u043A\u0440\u0430\u0441\u0438\u0442\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0443
      \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u0440\u0443\u0433\u0430 \u041F\u043E\u043B\u044F
      \u0413\u043E\u0433\u0435\u043D\u0430 \u043F\u0435\u0440\u0435\u0434 \u0435\u0433\u043E
      \u043F\u0440\u0438\u0435\u0437\u0434\u043E\u043C \u0432 \u0410\u0440\u043B\u044C."
    clip: {fileID: 8300000, guid: b86ba5433bc663f48900fb5b1c708035, type: 3}
  - key: supper-at-emmaus-caravaggio
    sourceText: "\u041A\u0430\u0440\u0430\u0432\u0430\u0434\u0436\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0448\u0435\u0433\u043E \u0425\u0440\u0438\u0441\u0442\u0430
      \u0431\u0435\u0437\u0431\u043E\u0440\u043E\u0434\u044B\u043C \u0438 \u044E\u043D\u044B\u043C:
      \u043F\u043E \u0435\u0432\u0430\u043D\u0433\u0435\u043B\u044C\u0441\u043A\u043E\u043C\u0443
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0443 \u0430\u043F\u043E\u0441\u0442\u043E\u043B\u044B
      \u043D\u0435 \u0441\u0440\u0430\u0437\u0443 \u0443\u0437\u043D\u0430\u043B\u0438
      \u0421\u043F\u0430\u0441\u0438\u0442\u0435\u043B\u044F, \u0438 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A
      \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u044D\u0442\u0443 \u043D\u0435\u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u044C."
    clip: {fileID: 8300000, guid: 11a81dc2d26763b4fbad53c891b2b4ba, type: 3}
  - key: tahitian-women-on-the-beach
    sourceText: "\u0413\u043E\u0433\u0435\u043D \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0443\u0436\u0435
      \u043B\u0435\u0442\u043E\u043C \u0442\u044B\u0441\u044F\u0447\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u0430, \u0432\u0441\u043A\u043E\u0440\u0435
      \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044F
      \u043D\u0430 \u0422\u0430\u0438\u0442\u0438, \u043A\u0443\u0434\u0430 \u043E\u043D
      \u0443\u0435\u0445\u0430\u043B \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
      \xAB\u043F\u0435\u0440\u0432\u043E\u0437\u0434\u0430\u043D\u043D\u043E\u0439\xBB
      \u0436\u0438\u0437\u043D\u0438, \u0434\u0430\u043B\u0451\u043A\u043E\u0439
      \u043E\u0442 \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u043E\u0439
      \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u0441\u0430\u043B\u043E\u043D\u043D\u043E\u0433\u043E
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430 \u041F\u0430\u0440\u0438\u0436\u0430."
    clip: {fileID: 8300000, guid: 77d6bb7d49ed00949ac18a49debb413b, type: 3}
  - key: the-anatomy-lesson-of-dr-nicolaes-tulp
    sourceText: "\u0422\u0440\u0443\u043F \u043D\u0430 \u0441\u0442\u043E\u043B\u0435
      \u2014 \u043A\u0430\u0437\u043D\u0451\u043D\u043D\u044B\u0439 \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A
      \u0410\u0440\u0438\u0441 \u041A\u0438\u043D\u0442, \u043F\u043E\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u0439
      \u0432 \u0442\u043E\u0442 \u0436\u0435 \u0434\u0435\u043D\u044C \u0437\u0430
      \u0443\u043B\u0438\u0447\u043D\u044B\u0439 \u0433\u0440\u0430\u0431\u0451\u0436;
      \u0445\u0438\u0440\u0443\u0440\u0433\u0438 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u0443
      \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0433\u043E \u0437\u0430\u043B\u0430
      \u0432 \u0430\u043C\u0441\u0442\u0435\u0440\u0434\u0430\u043C\u0441\u043A\u043E\u0439
      \u0412\u0430\u0433\u0435. \u0420\u0435\u043D\u0442\u0433\u0435\u043D \u0445\u043E\u043B\u0441\u0442\u0430
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043A\u0438\u0441\u0442\u044C
      \u0440\u0443\u043A\u0438 \u0442\u0440\u0443\u043F\u0430 \u0431\u044B\u043B\u0430
      \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u0430\u043D\u0430 \u2014 \u0441\u043F\u0435\u0440\u0432\u0430
      \u0420\u0435\u043C\u0431\u0440\u0430\u043D\u0434\u0442 \u0447\u0435\u0441\u0442\u043D\u043E
      \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B \u043E\u0431\u0440\u0443\u0431\u043E\u043A,
      \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u043F\u043E\u0441\u043B\u0435
      \u0430\u043C\u043F\u0443\u0442\u0430\u0446\u0438\u0438."
    clip: {fileID: 8300000, guid: 6973402724f8a5644ac0cae45f9e118d, type: 3}
  - key: the-ballet-class
    sourceText: "\u041F\u043E\u0436\u0438\u043B\u043E\u0433\u043E \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F
      \u0443\u0440\u043E\u043A\u0430 \u0414\u0435\u0433\u0430 \u043F\u0438\u0441\u0430\u043B
      \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u2014 \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u0442\u0430\u043D\u0446\u043E\u0432\u0449\u0438\u043A\u0430
      \u0438 \u0431\u0430\u043B\u0435\u0442\u043C\u0435\u0439\u0441\u0442\u0435\u0440\u0430
      \u0416\u044E\u043B\u044F \u041F\u0435\u0440\u0440\u043E, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438 \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u043B
      \u0432 \u041F\u0430\u0440\u0438\u0436\u0441\u043A\u043E\u0439 \u043E\u043F\u0435\u0440\u0435
      \u0438 \u0432 \u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435."
    clip: {fileID: 8300000, guid: 5944a231ebf0ed644a13447171a9919a, type: 3}
  - key: the-basket-of-apples
    sourceText: "\u041B\u0435\u0432\u044B\u0439 \u0438 \u043F\u0440\u0430\u0432\u044B\u0439
      \u043A\u0440\u0430\u044F \u0441\u0442\u043E\u043B\u0430 \u043D\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u0435
      \u043D\u0435 \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432 \u043E\u0434\u043D\u0443
      \u043B\u0438\u043D\u0438\u044E \u2014 \u0440\u0435\u043D\u0442\u0433\u0435\u043D
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u044D\u0442\u043E\u0442
      \xAB\u0441\u0431\u043E\u0439\xBB \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u044B
      \u0421\u0435\u0437\u0430\u043D\u043D \u0437\u0430\u0434\u0443\u043C\u0430\u043B
      \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E, \u0441\u0442\u0440\u0435\u043C\u044F\u0441\u044C
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u043D\u0435 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C, \u0430 \u0441\u0430\u043C\u043E
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0432\u0437\u0433\u043B\u044F\u0434\u0430."
    clip: {fileID: 8300000, guid: 123cf1f6fa33dc44f9fa7e64fe77e4dd, type: 3}
  - key: the-courtyard-of-a-house-in-delft
    sourceText: "\u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u043F\u043B\u0438\u0442\u0430
      \u0441 \u043B\u0430\u0442\u0438\u043D\u0441\u043A\u043E\u0439 \u043D\u0430\u0434\u043F\u0438\u0441\u044C\u044E
      \u0442\u044B\u0441\u044F\u0447\u0430 \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u0430 \u043D\u0430\u0434 \u043F\u0440\u043E\u0445\u043E\u0434\u043E\u043C
      \u2014 \u043D\u0435 \u0432\u044B\u0434\u0443\u043C\u043A\u0430 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430:
      \u043E\u043D\u0430 \u0431\u044B\u043B\u0430 \u0441\u043D\u044F\u0442\u0430
      \u0441 \u043F\u043E\u0440\u0442\u0430\u043B\u0430 \u0441\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F \u0438 \u0432\u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0430
      \u0432 \u0441\u0442\u0435\u043D\u0443 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0434\u0435 \u0425\u043E\u0445 \u0438 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043B.
      \u0421\u0432\u043E\u044E \u043F\u043E\u0434\u043F\u0438\u0441\u044C \xABP.D.H.
      / A \u0442\u044B\u0441\u044F\u0447\u0430 \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0432\u043E\u0441\u044C\u043C\u043E\u0439
      \u0433\u043E\u0434\xBB \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u043B
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0430\u0440\u043A\u0435 \u0441\u043B\u0435\u0432\u0430."
    clip: {fileID: 8300000, guid: 104c2ae9111121445b84a47e99bf34e7, type: 3}
  - key: the-cradle
    sourceText: "\u041C\u043E\u0440\u0438\u0437\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430
      \xAB\u041A\u043E\u043B\u044B\u0431\u0435\u043B\u044C\xBB \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u0439
      \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0435 \u0438\u043C\u043F\u0440\u0435\u0441\u0441\u0438\u043E\u043D\u0438\u0441\u0442\u043E\u0432
      \u0432 \u0442\u044B\u0441\u044F\u0447\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u0441\u0435\u043C\u044C\u0434\u0435\u0441\u044F\u0442 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u0443, \u0441\u0442\u0430\u0432 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u0436\u0435\u043D\u0449\u0438\u043D\u043E\u0439 \u0441\u0440\u0435\u0434\u0438
      \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432; \u043D\u0430
      \u043A\u0430\u0440\u0442\u0438\u043D\u0435 \u2014 \u0435\u0451 \u0441\u0435\u0441\u0442\u0440\u0430
      \u042D\u0434\u043C\u0430, \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0449\u0430\u044F
      \u0437\u0430 \u0441\u043F\u044F\u0449\u0435\u0439 \u0434\u043E\u0447\u0435\u0440\u044C\u044E
      \u0411\u043B\u0430\u043D\u0448."
    clip: {fileID: 8300000, guid: 3e15efbd0d1264a458078bf36c05814d, type: 3}
  - key: the-death-of-marat
    sourceText: "\u0414\u0430\u0432\u0438\u0434 \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435
      \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0441\u0432\u043E\u0435\u0433\u043E
      \u0434\u0440\u0443\u0433\u0430 \u041C\u0430\u0440\u0430\u0442\u0430, \u043F\u0440\u0438\u0434\u0430\u0432
      \u0441\u0446\u0435\u043D\u0435 \u0432\u0438\u0434 \u0441\u0432\u0435\u0442\u0441\u043A\u043E\u0439
      \u043F\u044C\u0435\u0442\u044B, \u0430 \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u043C
      \u043F\u043E\u0441\u0442\u0430\u043C\u0435\u043D\u0442\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C \xAB\xC0 Marat, David\xBB."
    clip: {fileID: 8300000, guid: b3396549e87367147aa05b77d613b39c, type: 3}
  - key: the-feast-of-saint-nicholas
    sourceText: "\u0414\u0435\u0432\u043E\u0447\u043A\u0430 \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u043C
      \u043F\u043B\u0430\u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430
      \u0446\u0435\u043B\u0443\u044E \u043A\u043E\u0440\u0437\u0438\u043D\u0443 \u043F\u043E\u0434\u0430\u0440\u043A\u043E\u0432
      \u043E\u0442 \u0421\u0438\u043D\u0442\u0435\u0440\u043A\u043B\u0430\u0430\u0441\u0430,
      \u0430 \u0435\u0451 \u043D\u0435\u0437\u0430\u0434\u0430\u0447\u043B\u0438\u0432\u044B\u0439
      \u0431\u0440\u0430\u0442 \u0441\u043B\u0435\u0432\u0430 \u0441\u043E \u0441\u043B\u0435\u0437\u0430\u043C\u0438
      \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0438\u0448\u044C
      \u043F\u0443\u0447\u043E\u043A \u0440\u043E\u0437\u043E\u0433. \u0424\u0430\u043C\u0438\u043B\u0438\u044F
      \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430 \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0430
      \u043D\u0438\u0434\u0435\u0440\u043B\u0430\u043D\u0434\u0446\u0430\u043C \u043A\u0440\u044B\u043B\u0430\u0442\u043E\u0435
      \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \xAB\u0434\u043E\u043C
      \u042F\u043D\u0430 \u0421\u0442\u0435\u043D\u0430\xBB \u2014 \u0441\u0438\u043D\u043E\u043D\u0438\u043C
      \u0432\u0435\u0441\u0451\u043B\u043E\u0433\u043E \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0433\u043E
      \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043A\u0430."
    clip: {fileID: 8300000, guid: 52f3351415afbfd46b2d78db5cea65e8, type: 3}
  - key: the-fighting-temeraire
    sourceText: "\u0422\u0451\u0440\u043D\u0435\u0440 \u043D\u0430\u0437\u044B\u0432\u0430\u043B
      \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0441\u0432\u043E\u0435\u0439
      \u043B\u044E\u0431\u0438\u043C\u043E\u0439 \u0438 \u043D\u0430\u043E\u0442\u0440\u0435\u0437
      \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0441\u044F \u0435\u0451
      \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C; \u0432 \u0434\u0432\u0435
      \u0442\u044B\u0441\u044F\u0447\u0438 \u043F\u044F\u0442\u044B\u0439 \u0433\u043E\u0434
      \u0433\u043E\u0434\u0443 \u043E\u043D\u0430 \u0431\u044B\u043B\u0430 \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0430
      \xAB\u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0435\u0439 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u0439
      \u0411\u0440\u0438\u0442\u0430\u043D\u0438\u0438\xBB \u043F\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C
      \u043E\u043F\u0440\u043E\u0441\u0430 BBC Radio 4."
    clip: {fileID: 8300000, guid: e3c74b15a2bd71b49abe480fc1b5d681, type: 3}
  - key: the-gallant-conversation
    sourceText: "\u0414\u043E\u043B\u0433\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438
      \xAB\u041E\u0442\u0446\u043E\u0432\u0441\u043A\u0438\u043C \u043D\u0430\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C\xBB,
      \u043F\u043E\u043B\u0430\u0433\u0430\u044F, \u0447\u0442\u043E \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u043E\u0442\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0447\u044C,
      \u2014 \u043D\u043E \u043F\u0440\u0438 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u043C
      \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u0438\u0438 \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C,
      \u0447\u0442\u043E \u043E\u043D \u0434\u0435\u0440\u0436\u0438\u0442 \u0432
      \u043F\u0430\u043B\u044C\u0446\u0430\u0445 \u043C\u043E\u043D\u0435\u0442\u0443,
      \u0430 \u0441\u0446\u0435\u043D\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442
      \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043E\u0442\u0446\u043E\u0432\u0441\u043A\u0443\u044E
      \u0437\u0430\u0431\u043E\u0442\u0443. \u0422\u0435\u0440 \u0411\u043E\u0440\u0445\u0430
      \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u0438 \u0446\u0435\u043D\u0438\u043B\u0438
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0432\u0441\u0435\u0433\u043E \u0437\u0430
      \u043F\u043E\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u0443\u044E
      \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u0431\u043B\u0435\u0441\u043A\u0430
      \u0430\u0442\u043B\u0430\u0441\u043D\u044B\u0445 \u0442\u043A\u0430\u043D\u0435\u0439."
    clip: {fileID: 8300000, guid: bc824c4c03536a94f93e519e92c7cc92, type: 3}
  - key: the-gleaners
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442
      \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u043E\u043A, \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u044E\u0449\u0438\u0445
      \u043D\u0430 \u043F\u043E\u043B\u0435 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435 \u0436\u0430\u0442\u0432\u044B \u043A\u043E\u043B\u043E\u0441\u043A\u0438,
      \u2014 \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043D\u0430\u044F
      \u043F\u0430\u0440\u0438\u0436\u0441\u043A\u0430\u044F \u043F\u0443\u0431\u043B\u0438\u043A\u0430
      \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u044F\u043B\u0430 \u044D\u0442\u043E\u0442
      \u0441\u044E\u0436\u0435\u0442 \u043A\u0430\u043A \u0434\u0435\u0440\u0437\u043A\u043E\u0435
      \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0431\u0435\u0434\u043D\u043E\u0442\u044B
      \u0434\u043E \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438."
    clip: {fileID: 8300000, guid: c47c3ead32834e649a1de67739316912, type: 3}
  - key: the-goldfinch
    sourceText: "\u0412 \u0442\u043E\u043C \u0436\u0435 \u0442\u044B\u0441\u044F\u0447\u0430
      \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 \u0433\u043E\u0434 \u0433\u043E\u0434\u0443
      \u0432\u0437\u0440\u044B\u0432 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u043E\u0433\u043E
      \u0441\u043A\u043B\u0430\u0434\u0430 \u2014 \u0442\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u044B\u0439
      \xAB\u0414\u0435\u043B\u0444\u0442\u0441\u043A\u0438\u0439 \u0433\u0440\u043E\u043C\xBB
      \u2014 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043B \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0438 \u0443\u0431\u0438\u043B \u0441\u0430\u043C\u043E\u0433\u043E
      \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430, \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0432
      \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0451 \u0435\u0433\u043E \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435:
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C \u043D\u0435
      \u0431\u043E\u043B\u0435\u0435 \u0434\u044E\u0436\u0438\u043D\u044B \u043F\u043E\u043B\u043E\u0442\u0435\u043D.
      \u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0434\u0430\u043B\u0430 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0440\u043E\u043C\u0430\u043D\u0443 \u0414\u043E\u043D\u043D\u044B \u0422\u0430\u0440\u0442\u0442
      \xAB\u0429\u0435\u0433\u043E\u043B\xBB, \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0435\u043C\u0443
      \u041F\u0443\u043B\u0438\u0442\u0446\u0435\u0440\u043E\u0432\u0441\u043A\u0443\u044E
      \u043F\u0440\u0435\u043C\u0438\u044E."
    clip: {fileID: 8300000, guid: d1b38decab4eb0a4fac56df097eb455a, type: 3}
  - key: the-gulf-stream
    sourceText: "\u041F\u0443\u0431\u043B\u0438\u043A\u0443 \u0432\u0437\u0432\u043E\u043B\u043D\u043E\u0432\u0430\u043B\u0430
      \u043D\u0435\u044F\u0441\u043D\u0430\u044F \u0441\u0443\u0434\u044C\u0431\u0430
      \u043C\u043E\u0440\u044F\u043A\u0430 \u043D\u0430 \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u0445
      \u043B\u043E\u0434\u043A\u0438 \u0441\u0440\u0435\u0434\u0438 \u0430\u043A\u0443\u043B;
      \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u043C\u0438
      \u043E \u0435\u0433\u043E \u0441\u0443\u0434\u044C\u0431\u0435, \u0425\u043E\u043C\u0435\u0440
      \u0441\u0430\u0440\u043A\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u0441\u0432\u043E\u0435\u043C\u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443
      \u043A\u0430\u0440\u0442\u0438\u043D\u0430\u043C\u0438, \u0447\u0442\u043E
      \u0442\u043E\u0442 \u0441\u043A\u043E\u0440\u043E \xAB\u0431\u0443\u0434\u0435\u0442
      \u0441\u043F\u0430\u0441\u0451\u043D, \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F
      \u043A \u0434\u0440\u0443\u0437\u044C\u044F\u043C \u0438 \u0434\u043E\u043C\u0443
      \u0438 \u0437\u0430\u0436\u0438\u0432\u0451\u0442 \u0434\u043E\u043B\u0433\u043E
      \u0438 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\xBB."
    clip: {fileID: 8300000, guid: 341bc29eb15114d4fa202e8f5415b520, type: 3}
  - key: the-hay-wain
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442
      \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
      \u043D\u0430 \u0440\u0435\u043A\u0435 \u0421\u0442\u0443\u0440 \u0432 \u0433\u0440\u0430\u0444\u0441\u0442\u0432\u0435
      \u0421\u0430\u0444\u0444\u043E\u043B\u043A \u0438 \u0441\u0442\u0430\u043B\u0430
      \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432
      \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u0441\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
      \u043F\u0435\u0439\u0437\u0430\u0436\u0430."
    clip: {fileID: 8300000, guid: 0c48807df3f655f4f8829bbd7d7613f9, type: 3}
  - key: the-jewish-bride
    sourceText: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u0435
      \u0432 \u0442\u044B\u0441\u044F\u0447\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044B\u0439
      \u0433\u043E\u0434 \u0433\u043E\u0434\u0443 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B
      \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u0435\u0440 \u0432\u0430\u043D
      \u0434\u0435\u0440 \u0425\u043E\u043E\u043F, \u0440\u0435\u0448\u0438\u0432,
      \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u043C\u0438
      \u043E\u0442\u0435\u0446, \u0434\u0430\u0440\u044F\u0449\u0438\u0439 \u0434\u043E\u0447\u0435\u0440\u0438
      \u0441\u0432\u0430\u0434\u0435\u0431\u043D\u043E\u0435 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435;
      \u043A\u0435\u043C \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0430 \u043F\u0430\u0440\u0430,
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u0432\u0435\u0434\u044B
      \u0441\u043F\u043E\u0440\u044F\u0442 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440.
      \u0412\u0430\u043D \u0413\u043E\u0433 \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u043B\u0441\u044F,
      \u0447\u0442\u043E \u043E\u0442\u0434\u0430\u043B \u0431\u044B \u0434\u0435\u0441\u044F\u0442\u044C
      \u043B\u0435\u0442 \u0436\u0438\u0437\u043D\u0438 \u0437\u0430 \u0434\u0432\u0435
      \u043D\u0435\u0434\u0435\u043B\u0438 \u043F\u0435\u0440\u0435\u0434 \u044D\u0442\u0438\u043C
      \u043F\u043E\u043B\u043E\u0442\u043D\u043E\u043C \u0441 \u043A\u0443\u0441\u043A\u043E\u043C
      \u0441\u0443\u0445\u043E\u0433\u043E \u0445\u043B\u0435\u0431\u0430."
    clip: {fileID: 8300000, guid: 236cca9d7db827640b9dc53d54dbb155, type: 3}
  - key: the-kiss
    sourceText: "\u0424\u0438\u0433\u0443\u0440\u044B \u0432\u043B\u044E\u0431\u043B\u0451\u043D\u043D\u044B\u0445
      \u043F\u043E\u043A\u0440\u044B\u0442\u044B \u0441\u0443\u0441\u0430\u043B\u044C\u043D\u044B\u043C
      \u0437\u043E\u043B\u043E\u0442\u043E\u043C \u2014 \u043A\u0430\u0440\u0442\u0438\u043D\u0430
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u043A \u0442\u0430\u043A
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u043E\u043C\u0443 \xAB\u0437\u043E\u043B\u043E\u0442\u043E\u043C\u0443
      \u043F\u0435\u0440\u0438\u043E\u0434\u0443\xBB \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
      \u041A\u043B\u0438\u043C\u0442\u0430."
    clip: {fileID: 8300000, guid: 84c97ec5655218c4996de0dfb7c99aec, type: 3}
  - key: the-last-day-of-pompeii
    sourceText: "\u041F\u043E\u043B\u043E\u0442\u043D\u043E \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0438\u043B\u043E
      \u041F\u0443\u0448\u043A\u0438\u043D\u0430 \u043D\u0430 \u043D\u0435\u043E\u043A\u043E\u043D\u0447\u0435\u043D\u043D\u043E\u0435
      \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435,
      \u0430 \u0432 \u043B\u0435\u0432\u043E\u043C \u0432\u0435\u0440\u0445\u043D\u0435\u043C
      \u0443\u0433\u043B\u0443 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B
      \u0441\u0430\u043C\u043E\u0433\u043E \u0441\u0435\u0431\u044F, \u0443\u0431\u0435\u0433\u0430\u044E\u0449\u0438\u043C
      \u043E\u0442 \u0438\u0437\u0432\u0435\u0440\u0436\u0435\u043D\u0438\u044F \u0441
      \u044F\u0449\u0438\u043A\u043E\u043C \u043A\u0440\u0430\u0441\u043E\u043A \u043D\u0430
      \u0433\u043E\u043B\u043E\u0432\u0435."
    clip: {fileID: 8300000, guid: 41407961562d5bd4da9a25715f3607d5, type: 3}
  - key: the-laughing-cavalier
    sourceText: "\u041C\u043E\u0434\u0435\u043B\u044C \u043D\u0430 \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0435
      \u0432\u043E\u0432\u0441\u0435 \u043D\u0435 \u0441\u043C\u0435\u0451\u0442\u0441\u044F
      \u0438, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0431\u044B\u043B\u0430 \u043A\u0430\u0432\u0430\u043B\u0435\u0440\u043E\u043C
      \u2014 \u0437\u0432\u0443\u0447\u043D\u043E\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B\u0430 \u043B\u0438\u0448\u044C
      \u0432\u0438\u043A\u0442\u043E\u0440\u0438\u0430\u043D\u0441\u043A\u0430\u044F
      \u043F\u0443\u0431\u043B\u0438\u043A\u0430 \u041B\u043E\u043D\u0434\u043E\u043D\u0430
      \u0432 \u0442\u044B\u0441\u044F\u0447\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u0441\u0435\u043C\u0438\u0434\u0435\u0441\u044F\u0442\u044B\u0439 \u0433\u043E\u0434-\u0445
      \u0433\u043E\u0434\u0430\u0445. \u0418\u043C\u044F \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D\u043D\u043E\u0433\u043E
      \u043C\u0443\u0436\u0447\u0438\u043D\u044B \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E:
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u043D\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0435\u0433\u043E \u0432\u043E\u0437\u0440\u0430\u0441\u0442 \u2014 26 \u043B\u0435\u0442
      \u2014 \u0438 \u0434\u0430\u0442\u0443 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u044F."
    clip: {fileID: 8300000, guid: 3c523cedc8734f04c9e6129d0c7a77c3, type: 3}
  - key: the-milkmaid
    sourceText: "\u0414\u043B\u044F \u0442\u0435\u043D\u0438 \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u043C
      \u043F\u043B\u0430\u043D\u0435 \u0412\u0435\u0440\u043C\u0435\u0435\u0440 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
      \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u043F\u0438\u0433\u043C\u0435\u043D\u0442
      \u0443\u043B\u044C\u0442\u0440\u0430\u043C\u0430\u0440\u0438\u043D \u2014 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E
      \u0449\u0435\u0434\u0440\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0434\u043B\u044F \u0431\u044B\u0442\u043E\u0432\u043E\u0439 \u0441\u0446\u0435\u043D\u044B."
    clip: {fileID: 8300000, guid: ea6764f9c3aec0b49a4248b893b7d8e7, type: 3}
  - key: the-night-watch
    sourceText: "\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u043A\u0430\u0440\u0442\u0438\u043D\u044B \u2014 \xAB\u0412\u044B\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435
      \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u0439 \u0440\u043E\u0442\u044B
      \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0430 \u0424\u0440\u0430\u043D\u0441\u0430
      \u0411\u0430\u043D\u043D\u0438\u043D\u0433\u0430 \u041A\u043E\u043A\u0430\xBB,
      \u0430 \u0442\u0451\u043C\u043D\u044B\u0439 \u043A\u043E\u043B\u043E\u0440\u0438\u0442
      \u043E\u043D\u0430 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0430 \u0438\u0437-\u0437\u0430
      \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u0432\u0448\u0435\u0433\u043E \u0441\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u043B\u0430\u043A\u0430."
    clip: {fileID: 8300000, guid: 292b840f95113cc4687dac9f799a4b53, type: 3}
  - key: the-ninth-wave
    sourceText: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043E\u0442\u0441\u044B\u043B\u0430\u0435\u0442
      \u043A \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u043E\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u044C\u044E
      \u043C\u043E\u0440\u044F\u043A\u043E\u0432: \u0434\u0435\u0432\u044F\u0442\u044B\u0439
      \u0432\u0430\u043B \u0432 \u0448\u0442\u043E\u0440\u043C\u0435 \u0441\u0447\u0438\u0442\u0430\u043B\u0441\u044F
      \u0441\u0430\u043C\u044B\u043C \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0438
      \u043E\u043F\u0430\u0441\u043D\u044B\u043C, \u043F\u043E\u0441\u043B\u0435
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0431\u0443\u0440\u044F \u0434\u043E\u043B\u0436\u043D\u0430
      \u0431\u044B\u043B\u0430 \u0441\u0442\u0438\u0445\u043D\u0443\u0442\u044C."
    clip: {fileID: 8300000, guid: 87d7dcc9e04c2dd4cba8919e76579312, type: 3}
  - key: the-proposition
    sourceText: "\u0420\u0435\u0434\u043A\u0438\u0439 \u0434\u043B\u044F \u0433\u043E\u043B\u043B\u0430\u043D\u0434\u0441\u043A\u043E\u0439
      \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438 \u0432\u0437\u0433\u043B\u044F\u0434
      \u0441 \u0436\u0435\u043D\u0441\u043A\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B:
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u043E
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0434\u0435\u0432\u0443\u0448\u043A\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B, \u0430 \u043E\u043D\u0430 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E
      \u043D\u0435 \u043E\u0442\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u0442
      \u0448\u0438\u0442\u044C\u044F. \u041A\u043E\u0433\u0434\u0430 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440
      \u041C\u0430\u0443\u0440\u0438\u0446\u0445\u0451\u0439\u0441\u0430 \u043A\u0443\u043F\u0438\u043B
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0432 \u0442\u044B\u0441\u044F\u0447\u0430
      \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0433\u043E\u0434 \u0433\u043E\u0434\u0443,
      \u0430\u0432\u0442\u043E\u0440 \u0435\u0449\u0451 \u043D\u0435 \u0431\u044B\u043B
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D \u2014 \u0441\u0430\u043C\u0443
      \u041B\u0435\u0439\u0441\u0442\u0435\u0440 \u043A \u0442\u043E\u043C\u0443
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0431\u044B\u043B\u0438."
    clip: {fileID: 8300000, guid: 21d060e827a7c774ca2a3f85fa28f644, type: 3}
  - key: the-raft-of-the-medusa
    sourceText: "\u0421\u044E\u0436\u0435\u0442 \u043E\u0441\u043D\u043E\u0432\u0430\u043D
      \u043D\u0430 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C \u043A\u0440\u0443\u0448\u0435\u043D\u0438\u0438
      \u0444\u0440\u0435\u0433\u0430\u0442\u0430 \xAB\u041C\u0435\u0434\u0443\u0437\u0430\xBB
      \u0432 \u0442\u044B\u0441\u044F\u0447\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u0448\u0435\u0441\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439 \u0433\u043E\u0434
      \u0433\u043E\u0434\u0443: \u0440\u0430\u0434\u0438 \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u0416\u0435\u0440\u0438\u043A\u043E
      \u0438\u0437\u0443\u0447\u0430\u043B \u0442\u0435\u043B\u0430 \u0432 \u043C\u043E\u0440\u0433\u0435
      \u0438 \u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043B \u0441 \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u043C\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u0440\u0438\u0431\u0435\u0433\u043D\u0443\u0442\u044C \u043A \u043A\u0430\u043D\u043D\u0438\u0431\u0430\u043B\u0438\u0437\u043C\u0443."
    clip: {fileID: 8300000, guid: 2ea11b6f00371ec41b957ad6d3537472, type: 3}
  - key: the-sea-of-ice
    sourceText: "\u0420\u0430\u0437\u0431\u0438\u0442\u044B\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C
      \u0441\u0440\u0435\u0434\u0438 \u043D\u0430\u0433\u0440\u043E\u043C\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0445
      \u043B\u044C\u0434\u0438\u043D \u043E\u0442\u0441\u044B\u043B\u0430\u0435\u0442
      \u043A \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u044B\u043C \u0430\u0440\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044F\u043C \u0423\u0438\u043B\u044C\u044F\u043C\u0430
      \u041F\u0430\u0440\u0440\u0438; \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438\u043A\u0438
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u043D\u0435 \u043F\u0440\u0438\u043D\u044F\u043B\u0438,
      \u0438 \u043E\u043D\u0430 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0430\u0441\u044C
      \u043D\u0435\u043F\u0440\u043E\u0434\u0430\u043D\u043D\u043E\u0439 \u0434\u043E
      \u0441\u0430\u043C\u043E\u0439 \u0441\u043C\u0435\u0440\u0442\u0438 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430
      \u0432 \u0442\u044B\u0441\u044F\u0447\u0430 \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442
      \u0441\u043E\u0440\u043E\u043A\u043E\u0432\u043E\u0439 \u0433\u043E\u0434 \u0433\u043E\u0434\u0443."
    clip: {fileID: 8300000, guid: 8ba7c8844e7f6f34f9e1ed94e0cc4507, type: 3}
  - key: the-sin
    sourceText: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0438\u043C\u0435\u043B\u0430
      \u0442\u0430\u043A\u043E\u0439 \u0443\u0441\u043F\u0435\u0445 \u043D\u0430
      \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0435 \u041C\u044E\u043D\u0445\u0435\u043D\u0441\u043A\u043E\u0433\u043E
      \u0421\u0435\u0446\u0435\u0441\u0441\u0438\u043E\u043D\u0430 \u0442\u044B\u0441\u044F\u0447\u0430
      \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0433\u043E\u0434 \u0433\u043E\u0434\u0430,
      \u0447\u0442\u043E \u0441\u0440\u0430\u0437\u0443 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u0428\u0442\u0443\u043A\u0430 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u043C;
      \u0432\u0441\u0435\u0433\u043E \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A
      \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u043E\u043A\u043E\u043B\u043E \u0434\u0435\u0441\u044F\u0442\u043A\u0430
      \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0445 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432
      \u044D\u0442\u043E\u0433\u043E \u0441\u044E\u0436\u0435\u0442\u0430."
    clip: {fileID: 8300000, guid: c333afebc88eb614db9641caf713fa34, type: 3}
  - key: the-swing
    sourceText: "\u0417\u0430\u043A\u0430\u0437\u0447\u0438\u043A \u043A\u0430\u0440\u0442\u0438\u043D\u044B
      \u043F\u043E\u0436\u0435\u043B\u0430\u043B, \u0447\u0442\u043E\u0431\u044B
      \u0435\u0433\u043E \u043B\u044E\u0431\u043E\u0432\u043D\u0438\u0446\u0430 \u0431\u044B\u043B\u0430
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0430 \u043D\u0430 \u043A\u0430\u0447\u0435\u043B\u044F\u0445
      \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043C\u043E\u0433
      \u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0451 \u0441\u043D\u0438\u0437\u0443,
      \u2014 \u0441\u044E\u0436\u0435\u0442 \u0441\u0442\u0430\u043B \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C
      \u0438\u0433\u0440\u0438\u0432\u043E\u0433\u043E \u0440\u043E\u043A\u043E\u043A\u043E."
    clip: {fileID: 8300000, guid: 836dc46e0873c3846bb2a46517a4639f, type: 3}
  - key: the-windmill-at-wijk-bij-duurstede
    sourceText: "\u0422\u0430 \u0441\u0430\u043C\u0430\u044F \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442,
      \u043D\u043E \u0441\u0430\u043C\u043E \u0437\u0434\u0430\u043D\u0438\u0435,
      \u0441\u043D\u044F\u0442\u043E\u0435 \u0441\u043D\u0438\u0437\u0443 \u0441\u043B\u043E\u0432\u043D\u043E
      \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A \u043D\u0430 \u0444\u043E\u043D\u0435
      \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043D\u0435\u0431\u0430, \u0441\u0442\u0430\u043B\u043E \u043F\u043E\u0447\u0442\u0438
      \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C \u0433\u043E\u043B\u043B\u0430\u043D\u0434\u0441\u043A\u043E\u0433\u043E
      \u043F\u0435\u0439\u0437\u0430\u0436\u0430. \u0421 \u0442\u044B\u0441\u044F\u0447\u0430
      \u0432\u043E\u0441\u0435\u043C\u044C\u0441\u043E\u0442 \u0432\u043E\u0441\u0435\u043C\u044C\u0434\u0435\u0441\u044F\u0442
      \u043F\u044F\u0442\u044B\u0439 \u0433\u043E\u0434 \u0433\u043E\u0434\u0430
      \u043A\u0430\u0440\u0442\u0438\u043D\u0430 \u0432\u0438\u0441\u0438\u0442 \u0432
      \u0413\u0430\u043B\u0435\u0440\u0435\u0435 \u043F\u043E\u0447\u0451\u0442\u0430
      \u0430\u043C\u0441\u0442\u0435\u0440\u0434\u0430\u043C\u0441\u043A\u043E\u0433\u043E
      \u0420\u0435\u0439\u043A\u0441\u043C\u0443\u0437\u0435\u0443\u043C."
    clip: {fileID: 8300000, guid: 8206fae3f2044cc47bac0b0af62a4f61, type: 3}
  - key: third-of-may-1808
    sourceText: "\u0413\u043E\u0439\u044F \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0441\u043F\u0443\u0441\u0442\u044F
      \u0448\u0435\u0441\u0442\u044C \u043B\u0435\u0442 \u043F\u043E\u0441\u043B\u0435
      \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u0430 \u043C\u0430\u0434\u0440\u0438\u0434\u0441\u043A\u0438\u0445
      \u043F\u043E\u0432\u0441\u0442\u0430\u043D\u0446\u0435\u0432 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u043C\u0438
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C\u0438, \u043F\u043E\u043A\u0430\u0437\u0430\u0432
      \u0432\u043E\u0439\u043D\u0443 \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u0436\u0435\u0440\u0442\u0432,
      \u0430 \u043D\u0435 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u0435\u0439."
    clip: {fileID: 8300000, guid: 3532244e09e084641992afb1749e28fe, type: 3}
  - key: three-beauties-of-the-present-day
    sourceText: "\u041D\u0430 \u0433\u0440\u0430\u0432\u044E\u0440\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u044B
      \u0442\u0440\u0438 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0441\u0442\u0438
      \u044D\u043F\u043E\u0445\u0438 \u042D\u0434\u043E \u2014 \u0433\u0435\u0439\u0448\u0430
      \u0422\u043E\u043C\u0438\u043C\u043E\u0442\u043E \u0422\u043E\u0451\u0445\u0438\u043D\u0430
      \u0438 \u0434\u0432\u0435 \u0447\u0430\u0439\u043D\u044B\u0435 \u043F\u043E\u0434\u0430\u0432\u0430\u043B\u044C\u0449\u0438\u0446\u044B,
      \u2014 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0423\u0442\u0430\u043C\u0430\u0440\u043E
      \u043D\u0430\u0434\u0435\u043B\u0438\u043B \u0442\u043E\u043D\u043A\u0438\u043C\u0438
      \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u0447\u0435\u0440\u0442\u0430\u043C\u0438, \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u043C\u0438
      \u0434\u043B\u044F \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u043D\u043E\u0439
      \u0443\u0441\u043B\u043E\u0432\u043D\u043E\u0441\u0442\u0438 \u0443\u043A\u0438\u0451-\u044D."
    clip: {fileID: 8300000, guid: 0e73c816b1e37cc4ca83bdd588891052, type: 3}
  - key: tribute-money
    sourceText: "\u041D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0444\u0440\u0435\u0441\u043A\u0435
      \u041C\u0430\u0437\u0430\u0447\u0447\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B
      \u0442\u0440\u0438 \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u043E\u0434\u043D\u043E\u0439
      \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u2014 \u043F\u0440\u0438\u043A\u0430\u0437
      \u0425\u0440\u0438\u0441\u0442\u0430, \u0434\u043E\u0431\u044B\u0447\u0443
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438\u0437\u043E \u0440\u0442\u0430
      \u0440\u044B\u0431\u044B \u0438 \u0443\u043F\u043B\u0430\u0442\u0443 \u043D\u0430\u043B\u043E\u0433\u0430,
      \u2014 \u0430 \u0441\u0445\u043E\u0434\u044F\u0449\u0438\u0435\u0441\u044F
      \u043B\u0438\u043D\u0438\u0438 \u043F\u043E\u0440\u0442\u0438\u043A\u0430 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u0442\u043E\u0447\u043A\u0443 \u0441\u0445\u043E\u0434\u0430 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u044B
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0425\u0440\u0438\u0441\u0442\u0430, \u043E\u0434\u043D\u043E \u0438\u0437
      \u043F\u0435\u0440\u0432\u044B\u0445 \u0441\u0442\u043E\u043B\u044C \u0442\u043E\u0447\u043D\u044B\u0445
      \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445
      \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0439 \u0432 \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438."
    clip: {fileID: 8300000, guid: e3047d002ca03b24ba21a83c9e63cfce, type: 3}
  - key: venus-and-mars
    sourceText: "\u0413\u043D\u0435\u0437\u0434\u043E \u043E\u0441 \u0443 \u0441\u0430\u043C\u043E\u0433\u043E
      \u0443\u0445\u0430 \u0441\u043F\u044F\u0449\u0435\u0433\u043E \u041C\u0430\u0440\u0441\u0430
      \u2014 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u043A\u0430\u043B\u0430\u043C\u0431\u0443\u0440
      \u043D\u0430 \u0444\u0430\u043C\u0438\u043B\u0438\u044E \u0412\u0435\u0441\u043F\u0443\u0447\u0447\u0438
      (\u043E\u0442 \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u043E\u0433\u043E
      vespa, \xAB\u043E\u0441\u0430\xBB), \u0437\u043D\u0430\u0442\u043D\u043E\u0433\u043E
      \u0444\u043B\u043E\u0440\u0435\u043D\u0442\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u0440\u043E\u0434\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0433
      \u0437\u0430\u043A\u0430\u0437\u0430\u0442\u044C \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0438\u043D\u0443."
    clip: {fileID: 8300000, guid: 4865be6bdbad15442b4ecc0aaa367178, type: 3}
  - key: wanderer-above-the-sea-of-fog
    sourceText: "\u0424\u0438\u0433\u0443\u0440\u0430 \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0430,
      \u043F\u043E\u0432\u0451\u0440\u043D\u0443\u0442\u043E\u0433\u043E \u0441\u043F\u0438\u043D\u043E\u0439
      \u043A \u0437\u0440\u0438\u0442\u0435\u043B\u044E, \u0441\u0442\u0430\u043B\u0430
      \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445
      \u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C\u044B\u0445 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432
      \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0433\u043E \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u0437\u043C\u0430."
    clip: {fileID: 8300000, guid: 341cf11a5a2858f44be51f828e89bf23, type: 3}
  - key: water-lilies
    sourceText: "\u041C\u043E\u043D\u0435 \u043F\u0438\u0441\u0430\u043B \u043A\u0443\u0432\u0448\u0438\u043D\u043A\u0438
      \u0432 \u0441\u0432\u043E\u0451\u043C \u0441\u0430\u0434\u0443 \u0432 \u0416\u0438\u0432\u0435\u0440\u043D\u0438:
      \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0442\u0440\u0438
      \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F \u0436\u0438\u0437\u043D\u0438
      \u043E\u043D \u0441\u043E\u0437\u0434\u0430\u043B \u043E\u043A\u043E\u043B\u043E
      \u0434\u0432\u0443\u0445\u0441\u043E\u0442 \u043F\u044F\u0442\u0438\u0434\u0435\u0441\u044F\u0442\u043E\u0433\u043E
      \u0433\u043E\u0434\u0430 \u043F\u043E\u043B\u043E\u0442\u0435\u043D \u0441
      \u044D\u0442\u0438\u043C \u043C\u043E\u0442\u0438\u0432\u043E\u043C, \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
      \u0443\u0431\u0438\u0440\u0430\u044F \u0441 \u0445\u043E\u043B\u0441\u0442\u0430
      \u043B\u0438\u043D\u0438\u044E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430
      \u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F \u043F\u0440\u0443\u0434
      \u0432 \u0431\u0435\u0441\u043A\u0440\u0430\u0439\u043D\u0435\u0435 \u043F\u043E\u043B\u0435
      \u0446\u0432\u0435\u0442\u0430 \u0438 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0439."
    clip: {fileID: 8300000, guid: a6f0c4a87a29f2345a6c28b09faee154, type: 3}
