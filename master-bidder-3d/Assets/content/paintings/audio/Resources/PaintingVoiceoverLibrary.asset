  genres:
  - key: filosofskaya-stsena
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u0430\u044F
      \u0441\u0446\u0435\u043D\u0430."
    clip: {fileID: 8300000, guid: 79a9ac675678bb742b5876b9008b9f02, type: 3}
  - key: gruppovoy-portret
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u0433\u0440\u0443\u043F\u043F\u043E\u0432\u043E\u0439
      \u043F\u043E\u0440\u0442\u0440\u0435\u0442."
    clip: {fileID: 8300000, guid: 9c5f3f1e49dc9ac41bfaf1ad46a3c93f, type: 3}
  - key: istoricheskaya-allegoriya
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0430\u043B\u043B\u0435\u0433\u043E\u0440\u0438\u044F."
    clip: {fileID: 8300000, guid: 7424768af738375448940ca9bc0ddfa5, type: 3}
  - key: istoricheskaya-stsena
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0441\u0446\u0435\u043D\u0430."
    clip: {fileID: 8300000, guid: a16e9556d1f42c34dacc24c69a13a335, type: 3}
  - key: mifologicheskaya-stsena
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u043C\u0438\u0444\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0441\u0446\u0435\u043D\u0430."
    clip: {fileID: 8300000, guid: f3bb90ed12f9bb8479785596e8a4d40e, type: 3}
  - key: natyurmort
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u043D\u0430\u0442\u044E\u0440\u043C\u043E\u0440\u0442."
    clip: {fileID: 8300000, guid: 403b7422605994f4696cced6d985db03, type: 3}
  - key: peyzazh
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u043F\u0435\u0439\u0437\u0430\u0436."
    clip: {fileID: 8300000, guid: d4d92036d6d3fef48a945618495ecd87, type: 3}
  - key: portret
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u043F\u043E\u0440\u0442\u0440\u0435\u0442."
    clip: {fileID: 8300000, guid: e7eed1af305f40d4584ba4ec5577e7ef, type: 3}
  - key: religioznaya-stsena
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u0430\u044F
      \u0441\u0446\u0435\u043D\u0430."
    clip: {fileID: 8300000, guid: 9f031dafd50474345a49819e33a523e9, type: 3}
  - key: zhanrovaya-stsena
    sourceText: "\u0416\u0430\u043D\u0440 \u2014 \u0436\u0430\u043D\u0440\u043E\u0432\u0430\u044F
      \u0441\u0446\u0435\u043D\u0430."
    clip: {fileID: 8300000, guid: 3c9ac55bc6eb70c4f967cfca3517115c, type: 3}
  periods:
  - key: barokko
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0431\u0430\u0440\u043E\u043A\u043A\u043E."
    clip: {fileID: 8300000, guid: 8aaa4e2eb53738c4bb5083a16a87efaf, type: 3}
  - key: gollandskoe-zolotoe-vremya
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0433\u043E\u043B\u043B\u0430\u043D\u0434\u0441\u043A\u043E\u0435
      \u0437\u043E\u043B\u043E\u0442\u043E\u0435 \u0432\u0440\u0435\u043C\u044F."
    clip: {fileID: 8300000, guid: c301420411b15554391723edb0ffadca, type: 3}
  - key: impressionizm
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0438\u043C\u043F\u0440\u0435\u0441\u0441\u0438\u043E\u043D\u0438\u0437\u043C."
    clip: {fileID: 8300000, guid: 1314463d2776ced42ad55f3fecadba58, type: 3}
  - key: neoklassitsizm
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u043D\u0435\u043E\u043A\u043B\u0430\u0441\u0441\u0438\u0446\u0438\u0437\u043C."
    clip: {fileID: 8300000, guid: c0e8f8729a2ba094d81f01a929ec6b7b, type: 3}
  - key: postimpressionizm
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u043F\u043E\u0441\u0442\u0438\u043C\u043F\u0440\u0435\u0441\u0441\u0438\u043E\u043D\u0438\u0437\u043C."
    clip: {fileID: 8300000, guid: 6a166a48ff8d7ff4080b270cc0cffbf6, type: 3}
  - key: rannee-vozrozhdenie
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0440\u0430\u043D\u043D\u0435\u0435
      \u0412\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435."
    clip: {fileID: 8300000, guid: febfabd99230275409a71f089074b793, type: 3}
  - key: realizm
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0440\u0435\u0430\u043B\u0438\u0437\u043C."
    clip: {fileID: 8300000, guid: d7176fbb049f020458e1e41edd67adc7, type: 3}
  - key: rokoko
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0440\u043E\u043A\u043E\u043A\u043E."
    clip: {fileID: 8300000, guid: 481fa89443932294aa0a0d7dad8d6c5e, type: 3}
  - key: romantizm
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u0437\u043C."
    clip: {fileID: 8300000, guid: bf2537032969c0c47be6e6596e8e83ca, type: 3}
  - key: severnoe-vozrozhdenie
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0435
      \u0412\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435."
    clip: {fileID: 8300000, guid: 8737811e8fa610641b0991e07aeafb28, type: 3}
  - key: simvolizm-venskiy-modern
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u043C
      (\u0432\u0435\u043D\u0441\u043A\u0438\u0439 \u043C\u043E\u0434\u0435\u0440\u043D)."
    clip: {fileID: 8300000, guid: 861edcdb27e2fb343a9272cf31063430, type: 3}
  - key: ukiyo-e
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0443\u043A\u0438\u0451-\u044D."
    clip: {fileID: 8300000, guid: 41a4f6a9b5c6afa4881206dbfaae9acf, type: 3}
  - key: vysokoe-vozrozhdenie
    sourceText: "\u0421\u0442\u0438\u043B\u044C \u2014 \u0432\u044B\u0441\u043E\u043A\u043E\u0435
      \u0412\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435."
    clip: {fileID: 8300000, guid: 5fabcd67783beb942a14778943f676a6, type: 3}
  artists:
  - key: anri-de-tuluz-lotrek
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0410\u043D\u0440\u0438 \u0434\u0435
      \u0422\u0443\u043B\u0443\u0437-\u041B\u043E\u0442\u0440\u0435\u043A."
    clip: {fileID: 8300000, guid: ea80d4e8282c7b64693ce66c92f3bdd2, type: 3}
  - key: antonis-van-deyk
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0410\u043D\u0442\u043E\u043D\u0438\u0441
      \u0432\u0430\u043D \u0414\u0435\u0439\u043A."
    clip: {fileID: 8300000, guid: ab46badb1cc3708468cab224def373a7, type: 3}
  - key: anzhelika-kaufman
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0410\u043D\u0436\u0435\u043B\u0438\u043A\u0430
      \u041A\u0430\u0443\u0444\u043C\u0430\u043D."
    clip: {fileID: 8300000, guid: 025e21ddcf616b9418f407870d010232, type: 3}
  - key: artemiziya-dzhentileski
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0410\u0440\u0442\u0435\u043C\u0438\u0437\u0438\u044F
      \u0414\u0436\u0435\u043D\u0442\u0438\u043B\u0435\u0441\u043A\u0438."
    clip: {fileID: 8300000, guid: 816ee190162650a46b4dab8deee492f1, type: 3}
  - key: berta-morizo
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0411\u0435\u0440\u0442\u0430
      \u041C\u043E\u0440\u0438\u0437\u043E."
    clip: {fileID: 8300000, guid: 12305fca62640f543b0aa709fb38dbbd, type: 3}
  - key: diego-velaskes
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0414\u0438\u0435\u0433\u043E
      \u0412\u0435\u043B\u0430\u0441\u043A\u0435\u0441."
    clip: {fileID: 8300000, guid: 634ccfc3bfcc8da41a756c38df656c49, type: 3}
  - key: dzhon-konstebl
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0414\u0436\u043E\u043D \u041A\u043E\u043D\u0441\u0442\u0435\u0431\u043B."
    clip: {fileID: 8300000, guid: 92486ed45ba0b2342adb9e9ea1d509c3, type: 3}
  - key: edgar-dega
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u042D\u0434\u0433\u0430\u0440
      \u0414\u0435\u0433\u0430."
    clip: {fileID: 8300000, guid: a50fdcd97cddb364bb1abfe549b02f2c, type: 3}
  - key: eduard-mane
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u042D\u0434\u0443\u0430\u0440\u0434
      \u041C\u0430\u043D\u0435."
    clip: {fileID: 8300000, guid: 00177dd3e2d922c4ca7bfd8b53a59e1e, type: 3}
  - key: egon-shile
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u042D\u0433\u043E\u043D \u0428\u0438\u043B\u0435."
    clip: {fileID: 8300000, guid: 65643b82a0f030f47b27e08a93857c69, type: 3}
  - key: ezhen-delakrua
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u042D\u0436\u0435\u043D \u0414\u0435\u043B\u0430\u043A\u0440\u0443\u0430."
    clip: {fileID: 8300000, guid: 1d363729dd554d049b7b9d65a9737d72, type: 3}
  - key: frans-khals
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0424\u0440\u0430\u043D\u0441
      \u0425\u0430\u043B\u044C\u0441."
    clip: {fileID: 8300000, guid: 0105dda6bfbf0fd4285612bc70b66c7a, type: 3}
  - key: fransisko-de-surbaran
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0424\u0440\u0430\u043D\u0441\u0438\u0441\u043A\u043E
      \u0434\u0435 \u0421\u0443\u0440\u0431\u0430\u0440\u0430\u043D."
    clip: {fileID: 8300000, guid: c815a43e2834a0b44b2f9e1342050bf6, type: 3}
  - key: fransisko-goyya
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0424\u0440\u0430\u043D\u0441\u0438\u0441\u043A\u043E
      \u0413\u043E\u0439\u044F."
    clip: {fileID: 8300000, guid: 7f5338040862bf94fbb0332e6c24a84a, type: 3}
  - key: frants-fon-shtuk
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0424\u0440\u0430\u043D\u0446
      \u0444\u043E\u043D \u0428\u0442\u0443\u043A."
    clip: {fileID: 8300000, guid: fcbf498be9298964f965b6161e4669f3, type: 3}
  - key: gans-golbeyn-mladshiy
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0413\u0430\u043D\u0441 \u0413\u043E\u043B\u044C\u0431\u0435\u0439\u043D
      \u041C\u043B\u0430\u0434\u0448\u0438\u0439."
    clip: {fileID: 8300000, guid: 761f3efc4c52a41488365870f81c8734, type: 3}
  - key: gerard-ter-borkh
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0413\u0435\u0440\u0430\u0440\u0434
      \u0442\u0435\u0440 \u0411\u043E\u0440\u0445."
    clip: {fileID: 8300000, guid: 5f93c9b3df904b5499955d1d91575c0f, type: 3}
  - key: gustav-klimt
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0413\u0443\u0441\u0442\u0430\u0432
      \u041A\u043B\u0438\u043C\u0442."
    clip: {fileID: 8300000, guid: 9873359e84388eb4f9531896474ce008, type: 3}
  - key: gvido-reni
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0413\u0432\u0438\u0434\u043E
      \u0420\u0435\u043D\u0438."
    clip: {fileID: 8300000, guid: b63f5602c996e6745aac68c481f88fbe, type: 3}
  - key: gyustav-kurbe
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0413\u044E\u0441\u0442\u0430\u0432
      \u041A\u0443\u0440\u0431\u0435."
    clip: {fileID: 8300000, guid: c4a0e5fa43318c846bc242f764460585, type: 3}
  - key: ieronim-boskh
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0418\u0435\u0440\u043E\u043D\u0438\u043C
      \u0411\u043E\u0441\u0445."
    clip: {fileID: 8300000, guid: 54888cb4414a76647ab58a67a4100ef0, type: 3}
  - key: ilya-repin
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0418\u043B\u044C\u044F \u0420\u0435\u043F\u0438\u043D."
    clip: {fileID: 8300000, guid: 71ef2743a2792ba47ad7005da33c512e, type: 3}
  - key: ivan-ayvazovskiy
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0418\u0432\u0430\u043D \u0410\u0439\u0432\u0430\u0437\u043E\u0432\u0441\u043A\u0438\u0439."
    clip: {fileID: 8300000, guid: 8825258f0058294478c0ff43e845b4c2, type: 3}
  - key: kamil-pissarro
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041A\u0430\u043C\u0438\u043B\u044C
      \u041F\u0438\u0441\u0441\u0430\u0440\u0440\u043E."
    clip: {fileID: 8300000, guid: dc7a69d869e0e6c4fa9fb0409cf21100, type: 3}
  - key: karavadzho
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041A\u0430\u0440\u0430\u0432\u0430\u0434\u0436\u043E."
    clip: {fileID: 8300000, guid: 11151356e79794243b1c90b267160c06, type: 3}
  - key: karel-fabritsius
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041A\u0430\u0440\u0435\u043B
      \u0424\u0430\u0431\u0440\u0438\u0446\u0438\u0443\u0441."
    clip: {fileID: 8300000, guid: ffab9563909334d46ab4bc412c6fcf0b, type: 3}
  - key: karl-bryullov
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041A\u0430\u0440\u043B \u0411\u0440\u044E\u043B\u043B\u043E\u0432."
    clip: {fileID: 8300000, guid: 6d5777561d36a13458923cea358a7bfa, type: 3}
  - key: kaspar-david-fridrikh
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041A\u0430\u0441\u043F\u0430\u0440
      \u0414\u0430\u0432\u0438\u0434 \u0424\u0440\u0438\u0434\u0440\u0438\u0445."
    clip: {fileID: 8300000, guid: 0a3a617082154824db228e40164a6775, type: 3}
  - key: katsusika-khokusay
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041A\u0430\u0446\u0443\u0441\u0438\u043A\u0430
      \u0425\u043E\u043A\u0443\u0441\u0430\u0439."
    clip: {fileID: 8300000, guid: 6a477936612f89f42bfe54355a153026, type: 3}
  - key: khusepe-de-ribera
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u0425\u0443\u0441\u0435\u043F\u0435
      \u0434\u0435 \u0420\u0438\u0431\u0435\u0440\u0430."
    clip: {fileID: 8300000, guid: fec4e6ad81015ab4e847513aa8fda49e, type: 3}
  - key: kitagava-utamaro
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041A\u0438\u0442\u0430\u0433\u0430\u0432\u0430
      \u0423\u0442\u0430\u043C\u0430\u0440\u043E."
    clip: {fileID: 8300000, guid: 696737db991421c4e8c2e39384dac7fc, type: 3}
  - key: klod-mone
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041A\u043B\u043E\u0434 \u041C\u043E\u043D\u0435."
    clip: {fileID: 8300000, guid: 4b012e2fb1170444989a575bb1d0221e, type: 3}
  - key: leonardo-da-vinchi
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041B\u0435\u043E\u043D\u0430\u0440\u0434\u043E
      \u0434\u0430 \u0412\u0438\u043D\u0447\u0438."
    clip: {fileID: 8300000, guid: fa5b7c8ed531da14ea125f54c53555ee, type: 3}
  - key: mazachcho
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041C\u0430\u0437\u0430\u0447\u0447\u043E."
    clip: {fileID: 8300000, guid: 584c405512ff8bd42bfb9bcc8242a5dc, type: 3}
  - key: meri-kassat
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041C\u044D\u0440\u0438 \u041A\u0430\u0441\u0441\u0430\u0442."
    clip: {fileID: 8300000, guid: 077739cfe050b184c970a85979fdf545, type: 3}
  - key: mikelandzhelo-buonarroti
    sourceText: "\u0410\u0432\u0442\u043E\u0440 \u2014 \u041C\u0438\u043A\u0435\u043B\u0430\u043D\u0434\u0436\u0435\u043B\u043E
      \u0411\u0443\u043E\u043D\u0430\u0440\u0440\u043E\u0442\u0438."
    clip: {fileID: 8300000, guid: 2fcae0a7c7df9d740bdfc7b550a05c05, type: 3}
  - key: nikola-pussen
