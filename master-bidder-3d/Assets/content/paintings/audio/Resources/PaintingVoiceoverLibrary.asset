    clip: {fileID: 8300000, guid: 4fc5692ac70e4754494e9218d34ae34a, type: 3}
  - key: 1637
    sourceText: "\u0442\u044B\u0441\u044F\u0447\u0430 \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0441\u0435\u0434\u044C\u043C\u043E\u0439
      \u0433\u043E\u0434."
